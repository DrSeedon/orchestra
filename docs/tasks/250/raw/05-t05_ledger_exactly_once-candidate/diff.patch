-"""Add focused regression tests here."""
+from src.ledger import Ledger, charge_invoice
 
+
+def test_retrying_invoice_charge_creates_one_debit_with_original_amount():
+    ledger = Ledger()
+    ledger.entries.append({"kind": "audit", "invoice_id": "inv-1"})
+
+    first = charge_invoice(ledger, "inv-1", 1250)
+    second = charge_invoice(ledger, "inv-1", 9999)
+
+    debits = [
+        entry
+        for entry in ledger.entries
+        if entry.get("kind") == "debit" and entry.get("invoice_id") == "inv-1"
+    ]
+    assert first == {"ok": True, "duplicate": False}
+    assert second == {"ok": True, "duplicate": True}
+    assert debits == [{"kind": "debit", "invoice_id": "inv-1", "amount_cents": 1250}]
