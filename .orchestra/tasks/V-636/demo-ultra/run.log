import csv

def main():
allowed_licenses = {
'MIT', 'BSD-3-Clause', 'Apache-2.0', 'Public Domain', 'Проприетарная'
}
allowed_count = 0
needs_review_count = 0

with open('компоненты.csv', 'r', encoding='utf-8', newline='') as f:
    reader = csv.reader(f, delimiter=';')
    next(reader, None)  # пропустить заголовок
    for row in reader:
        if len(row) < 2:
            continue
        component = row[0].strip()
        license_ = row[1].strip()
        if license_ in allowed_licenses:
            status = 'допустима'
            allowed_count += 1
        else:
            status = 'требует проверки'
            needs_review_count += 1
        print(f'{component} — {license_} — {status}')

print(f'Итого: допустимо — {allowed_count}, требует проверки — {needs_review_count}')


if name == 'main':
main()

