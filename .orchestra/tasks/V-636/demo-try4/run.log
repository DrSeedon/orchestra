import csv

def main():
    allowed_licenses = {"MIT", "BSD-3-Clause", "Apache-2.0", "Public Domain", "Проприетарная"}
    valid_count = 0
    check_count = 0

    with open('компоненты.csv', 'r', encoding='utf-8') as file:
        reader = csv.reader(file, delimiter=';')
        next(reader)  # Пропускаем заголовок
        for row in reader:
            component = row[0]
            license = row[1]
            if license in allowed_licenses:
                print(f"{component} — {license} — допустима")
                valid_count += 1
            else:
                print(f"{component} — {license} — требует проверки")
                check_count += 1

    print(f"Итог: допустимых компонентов — {valid_count}, требующих проверки — {check_count}")

if __name__ == "__main__":
    main()


