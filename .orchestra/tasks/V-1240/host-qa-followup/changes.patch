+        answer.locator('summary').click()
+        expect(answer.locator('pre')).to_have_text('First answer expands here')
+        assert page.evaluate('window.__workflowApiRequests') == requests_before + [
+            '/api/bg/workflows/V-776-fixture/results/0',
+        ]
+    finally:
+        page.close()
