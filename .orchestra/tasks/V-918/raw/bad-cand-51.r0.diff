+    nulled = _slot_text(browser, prelude + f"window.api = async () => {_history(8, step=10, nulls=(3, 4))};")
+    missing = _slot_text(browser, prelude + f"window.api = async () => {_history(8, step=10, drop=(3, 4))};")
