+                interpreter=result["interpreter"],
+            )
+    except (OSError, RuntimeError, subprocess.TimeoutExpired) as exc:
+        return {
+            **result,
+            "status": INCONCLUSIVE,
+            "reason": "tree_failed",
+            "output": str(exc),
+        }
+    mutation = {
+        **second,
+        "changed_tests": tests,
+        "changed_sources": sources,
+        "target_sha": commit,
+        "interpreter": result["interpreter"],
+        "selected_nodes": selected_nodes,
+        "fallback_files": fallback_files,
+    }
+    if second["status"] == FAILED:
