+_TEST_PATH_PREFIX = "tests/"
+_SOURCE_PREFIXES = ("app/", "scripts/")
+_NON_SOURCE_PREFIXES = (
+    ".orchestra/", ".github/", "docs/", "prompts/", "prompt/",
+)
+_NON_SOURCE_SUFFIXES = {
+    ".md", ".rst", ".txt", ".toml", ".ini", ".cfg", ".yaml", ".yml", ".json",
+}
