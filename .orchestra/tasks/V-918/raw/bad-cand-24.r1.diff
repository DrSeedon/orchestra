+async def _tg_send_file_safe(
+    chat_id: int, path: str, caption: str | None, thread_id: int | None,
+    *, is_photo: bool, important: bool,
+):
+    from aiogram.types import FSInputFile
+
+    async def _send():
+        tg_file = FSInputFile(path, filename=Path(path).name)
