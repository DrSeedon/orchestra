+def _wrap_line(text: str, cols: int = WRAP_COLS) -> list[str]:
+    if len(text) <= cols:
+        return [text]
+    parts = []
+    while len(text) > cols:
+        parts.append(text[:cols])
+        text = text[cols:]
+    if text:
+        parts.append(text)
+    return parts
+
