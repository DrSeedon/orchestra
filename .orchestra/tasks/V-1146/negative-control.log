        _insert_error_rows(hub_finish_db, [("error", raw, None, 1)], stamp)
        original_events = watch.collect_db_events(hub_finish_db, started)
        assert [event["message"] for event in original_events] == [_CAPACITY_REFUSAL] * 5 + [raw] * 5
