+def _attention_ddl(connection):
+    row = connection.execute(
+        "SELECT sql FROM sqlite_master WHERE type='table' AND name='attention_events'"
+    ).fetchone()
+    return " ".join(row[0].split()) if row else None
+
+
+def test_v3_database_without_attention_events_gets_the_table_at_startup(tmp_path):
+    path = tmp_path / "data" / "orchestra.db"
+    db.init_db(path)
+    with sqlite3.connect(path) as connection:
+        fresh = _attention_ddl(connection)
+        connection.execute("DROP TABLE attention_events")
+    assert fresh
+
+    db.init_db(path)
+
+    with sqlite3.connect(path) as connection:
+        restored = _attention_ddl(connection)
+    assert restored == fresh
+
+
+def test_attention_events_ensure_keeps_rows_of_a_hand_made_table(tmp_path):
+    path = tmp_path / "data" / "orchestra.db"
+    db.init_db(path)
+    with sqlite3.connect(path) as connection:
+        connection.execute("PRAGMA foreign_keys=OFF")
+        connection.execute(
+            "INSERT INTO attention_events VALUES ('a1','legacy','why','s1','2026-09-28')"
+        )
+        connection.commit()
+
+    db.init_db(path)
+    db.init_db(path)
+
+    with sqlite3.connect(path) as connection:
+        assert connection.execute("SELECT id FROM attention_events").fetchall() == [("a1",)]
+
+
+def test_notify_user_works_on_a_migrated_database_that_lacked_the_table(
+    tmp_path, monkeypatch,
+):
+    from app import attention
+
+    path = tmp_path / "data" / "orchestra.db"
+    monkeypatch.setattr(db, "DB_PATH", path)
+    db.init_db(path)
+    with sqlite3.connect(path) as connection:
+        connection.execute("DROP TABLE attention_events")
+        connection.execute(
+            "INSERT INTO sessions(id,name,scope,cwd,model,status,role,created_at) "
+            "VALUES ('s1','w','/s','/tmp','m','idle','orchestrator','2026-09-29')"
+        )
+    with pytest.raises(sqlite3.OperationalError, match="no such table: attention_events"):
+        attention.create_attention("s1", "look")
+
+    db.init_db(path)
+
+    assert attention.create_attention("s1", "look")["reason"] == "look"
