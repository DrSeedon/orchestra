+@pytest.mark.asyncio
+async def test_rejected_claim_frees_nothing_and_the_retry_still_frees_the_worker(
+    monkeypatch, tmp_path,
+):
+    """Release and claim are one transaction, and the release does not depend on the
+    session's own `task_id`: a rejected claim quarantines the session with an empty one,
+    yet the retry must still find and free the binding left behind."""
+    from app import tm
+
+    repo, worktree, found = await _continued_worker(monkeypatch, tmp_path)
+    real_update = tm.api_update_task_if_current
+
+    def claim_rejected(identity, **kwargs):
+        # The reservation appears after the route's preflight looked: the claim itself
+        # must fail and take the release down with it.
+        kwargs["require_unreserved"] = True
+        return real_update(identity, **kwargs)
+
+    with tm._conn() as connection:
+        connection.execute(
+            "INSERT INTO tm_task_reservations "
+            "(task_id, operation_id, kind, session_id, created_at) VALUES (?,?,?,?,?)",
+            (_task(NEXT)["id"], "other-merge", "assign", "someone", "2026-09-29"),
+        )
+    monkeypatch.setattr(tm, "api_update_task_if_current", claim_rejected)
+
+    rejected = await _switch(found)
+
+    assert rejected["ok"] is False, rejected
+    previous = _task(PREVIOUS)
+    assert (previous["status"], previous["worker_session_id"]) == ("in_progress", found.id)
+    assert [r["status"] for r in _open_runs(found.id)] == ["requested"]
+
+    monkeypatch.setattr(tm, "api_update_task_if_current", real_update)
+    with tm._conn() as connection:
+        connection.execute("DELETE FROM tm_task_reservations WHERE operation_id='other-merge'")
+
+    retry = await _switch(found)
+
+    assert isinstance(retry, dict) and retry["ok"] is True, _dump(retry)
+    assert retry["previous_tasks"] == [{"task": PREVIOUS, "outcome": "requeued"}]
+    assert _task(PREVIOUS)["worker_session_id"] is None
+    assert _task(NEXT)["worker_session_id"] == found.id
+
