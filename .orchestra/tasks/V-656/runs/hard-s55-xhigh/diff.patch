+async def _plan_previous_task_release(
+    found, *, task_identity, held: list[str], done_ref: str,
+) -> tuple[dict | None, JSONResponse | None]:
+    """May this switch free the worker of the task it still holds? (V-620)
+
+    A `continue` merge leaves the task bound with an open run, and a branch equal to its
+    target can no longer be merged, so the binding would outlive the work forever and
+    block every later assignment. The switch releases it, but only when nothing of the
+    worker's is left on the old branch: no uncommitted files and no commits outside the
+    base. With leftovers the binding stays and the ordinary switch rules apply; a caller
+    who explicitly said the task is done gets a refusal instead of a silent downgrade.
+    """
+    from app import tm as _tm
+    from app.workspace import branch_wip_status
+
+    def refuse(error: str, state: str) -> tuple[None, JSONResponse]:
+        return None, JSONResponse({"error": error, "state": state}, status_code=409)
+
+    leftover = ""
+    try:
+        wip = await asyncio.to_thread(
+            branch_wip_status, found.worktree_path, _session_base_branch(found, ""),
+        )
+        if wip.get("error"):
+            leftover = f"its git state cannot be verified: {wip['error']}"
+        elif wip["uncommitted"]:
+            leftover = f"{len(wip['uncommitted'])} uncommitted file(s)"
+        elif wip["unmerged_commits"]:
+            leftover = f"{len(wip['unmerged_commits'])} commit(s) not merged into the base"
+    except Exception as error:
+        leftover = f"its git state cannot be read: {err_text(error)}"
+    if leftover:
+        if done_ref:
+            return refuse(
+                f"previous_task_done refused: worker '{found.name}' still holds task "
+                f"{done_ref} and {leftover} — merge_worker or commit first; "
+                "nothing was changed",
+                "previous_task_not_settled",
+            )
+        return None, None
+
+    spec = {"session_id": found.id, "done_task": done_ref}
+    try:
+        await asyncio.to_thread(
+            _tm.preflight_previous_release, found.id, task_identity["id"], done_ref,
+        )
+    except ValueError as error:
+        return refuse(
+            f"cannot release {', '.join(held)} from '{found.name}': {error}; "
+            "nothing was changed",
+            "previous_task_release_refused",
+        )
+    return spec, None
+
+
