+def _previous_binding_plan(
+    conn: sqlite3.Connection, session_id: str, keep_task_id: int, done_ref: str,
+) -> tuple[list[dict], dict | None]:
+    """Check what a branch switch may take off the worker; nothing is written.
+
+    Returns the tasks still bound to the session (other than the one it is moving to)
+    and, when `done_ref` is given, the one of them to close as done. A task held by an
+    in-flight merge operation is never touched: the merge owns its outcome.
+    """
+    bound = [
+        dict(row) for row in conn.execute(
+            "SELECT t.*, p.scope FROM tm_tasks t "
+            "JOIN tm_projects p ON p.id = t.project_id "
+            "WHERE t.worker_session_id = ? AND t.id != ?",
+            (session_id, keep_task_id),
+        ).fetchall()
+    ]
+    for row in bound:
+        reservation = conn.execute(
+            "SELECT operation_id FROM tm_task_reservations WHERE task_id = ?",
+            (row["id"],),
+        ).fetchone()
+        if reservation:
+            raise ValueError(
+                f"task {public_task_ref(row)} is reserved by operation "
+                f"{reservation['operation_id']}; its merge is still in flight"
+            )
+    if not done_ref:
+        return bound, None
+    target = next((row for row in bound if public_task_ref(row) == done_ref), None)
+    if target is None:
+        raise ValueError(f"task {done_ref} is not bound to this worker; nothing to close as done")
+    if target["status"] not in {"in_progress", "done"}:
+        raise ValueError(
+            f"task {done_ref} is {target['status']}; only an in_progress task can be closed as done"
+        )
+    others = _live_bindings(conn, target["scope"], done_ref, session_id)
+    if others:
+        raise ValueError(
+            f"task {done_ref} still has live workers ({', '.join(sorted(others))}) — "
+            "closing it as done is refused"
+        )
+    return bound, target
+
+
+def held_task_bindings(session_id: str, keep_task_id: int) -> list[str]:
+    """Refs of the tasks a session still holds besides `keep_task_id`.
+
+    Held means either side of the binding: a task row that names the session, or an open
+    task run for it. The session's own `task_id` is not consulted — a failed switch
+    quarantines it with an empty `task_id` while the old binding and its run stay behind,
+    and that leftover is exactly what blocks the next assignment.
+
+    Both sides live only in the local projection (never in the Git task records), so this
+    gate reads SQLite alone; the transaction that acts on it repeats every check.
+    """
+    with _conn() as conn:
+        keep = get_task_by_id(conn, keep_task_id)
+        keep_ref = public_task_ref(keep) if keep else ""
+        refs = {
+            public_task_ref(row) for row in conn.execute(
+                "SELECT * FROM tm_tasks WHERE worker_session_id = ? AND id != ?",
+                (session_id, keep_task_id),
+            ).fetchall()
+        }
+        refs.update(
+            str(row["task_id"]) for row in conn.execute(
+                "SELECT task_id FROM review_receipts WHERE subject_kind='task_run' "
+                "AND session_id = ? AND status = 'requested' AND task_id != ?",
+                (session_id, keep_ref),
+            ).fetchall()
+        )
+        return sorted(refs)
+
+
+def preflight_previous_release(session_id: str, keep_task_id: int, done_ref: str = "") -> None:
+    """Fail early for UX; the mutation owner repeats these checks transactionally."""
+    with active_runtime().operation(), _conn() as conn:
+        _previous_binding_plan(conn, session_id, keep_task_id, done_ref)
+
+
+def _release_previous_bindings(
+    conn: sqlite3.Connection, session_id: str, keep_task_id: int, done_ref: str,
+) -> list[dict]:
+    """Free the worker of the task it is leaving, inside the caller's transaction.
+
+    A `continue` merge leaves the task bound with an open run, and once the branch equals
+    the target no further merge can close it (the merge refuses an empty delta). The switch
+    that moves the worker on is the only remaining exit, so it releases the binding: the
+    run ends `interrupted/binding_released` and the task goes back to the queue, unless the
+    caller vouched for it with `done_ref`, which closes it as done and ends the run
+    `completed`. Any other task still held by the session is released the usual way, so a
+    stale run cannot block the new assignment again.
+    """
+    _bound, target = _previous_binding_plan(conn, session_id, keep_task_id, done_ref)
+    released: list[dict] = []
+    if target is not None:
+        if target["status"] == "in_progress":
+            update_task(conn, target["id"], status="done")
+        _finish_task_run_for_task(conn, target, session_id, status="completed")
+        conn.execute(
+            "UPDATE tm_tasks SET worker_session_id=NULL, "
+            "sync_revision=sync_revision+1, updated_at=? WHERE id=?",
+            (_now(), target["id"]),
+        )
+        active_runtime().publish(conn, target["id"])
+        released.append({"task": done_ref, "outcome": "done"})
+    released.extend(
+        release_session_task_binding(conn, session_id, keep_task_id=keep_task_id)
+    )
+    keep = get_task_by_id(conn, keep_task_id)
+    template = conn.execute(
+        "SELECT template_hash FROM sessions WHERE id=?", (session_id,),
+    ).fetchone()
+    for run in conn.execute(
+        "SELECT task_id FROM review_receipts WHERE subject_kind='task_run' "
+        "AND session_id=? AND status='requested' AND task_id != ?",
+        (session_id, public_task_ref(keep) if keep else ""),
+    ).fetchall():
+        # A run whose task row no longer names this session: nothing else would end it,
+        # and one open run per session is what the next assignment insists on.
+        task_run_receipt_finish(
+            session_id=session_id,
+            task_id=str(run["task_id"]),
+            status="interrupted",
+            prompt_template_end=str(template["template_hash"] or "") if template else "",
+            failure_code="binding_released",
+            connection=conn,
+        )
+        released.append({"task": str(run["task_id"]), "outcome": "run_closed"})
+    return released
