+"""V-620: a worker left bound by a `continue` merge is freed by `switch_worker_branch`.
+
+The clinch reproduced 23.09.2026 (katya-work): after `merge_worker(task_outcome="continue")`
+the worker keeps its task and an open task run, its branch equals the target, and both
+exits are closed — the merge refuses an empty delta, the switch died on
+`open task run conflicts with current assignment provenance`. Every scenario below runs on a
+real repository and the real merge path; only the SQLite file and the task store are the
+per-test temporary ones from `conftest`.
+"""
+
+import sqlite3
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from tests.task_seeds import create_task as seed_task
+from tests.test_task_tracker_integration import (
+    _commit_file,
+    _init_db,
+    _make_git_scope,
+    _prepare_merge,
+    _save_worker,
+)
+
+WORKER = "ege-worker"
+PREVIOUS = "V-5"
+NEXT = "V-6"
+
+
+@pytest.fixture(autouse=True)
+def _vps_task_refs(monkeypatch):
+    monkeypatch.setenv("ORCHESTRA_TASK_PREFIX", "V-")
+
+
+def _git(path, *args) -> str:
+    return subprocess.run(
+        ["git", *args], cwd=path, check=True, capture_output=True, text=True,
+    ).stdout.strip()
+
+
+def _task(ref: str) -> dict:
+    from app import tm
+
+    with tm._conn() as connection:
+        project = tm.get_project_by_scope(connection, _task.scope)
+        return tm.resolve_task_ref(connection, ref, project["id"])
+
+
+def _open_runs(session_id: str) -> list[dict]:
+    from app import tm
+
+    with tm._conn() as connection:
+        return [
+            dict(row) for row in connection.execute(
+                "SELECT task_id, status, failure_code FROM review_receipts "
+                "WHERE subject_kind='task_run' AND session_id=? ORDER BY requested_at",
+                (session_id,),
+            ).fetchall()
+        ]
+
+
+async def _merged_worker(monkeypatch, tmp_path: Path, outcome: str):
+    """A worker that merged real work through the real merge path and has nothing left."""
+    import app.routes.sessions as sessions_route
+    import app.workspace as workspace
+    from app import tm
+
+    _init_db()
+    repo = _make_git_scope(monkeypatch, tmp_path)
+    scope = str(repo)
+    _task.scope = scope
+    with tm._conn() as connection:
+        tm.ensure_project(connection, "project", scope=scope)
+        seed_task(connection, "project", "Structure of the exam", par_number=5)
+        seed_task(connection, "project", "Next task", par_number=6)
+    worktree = workspace.create_worktree(scope, WORKER, task_id=PREVIOUS)
+    worker_head = _commit_file(worktree.path, "structure.txt", "V-5: structure of the exam")
+    _save_worker(
+        session_id=WORKER, task_id=PREVIOUS, scope=scope,
+        worktree_path=worktree.path, branch=worktree.branch,
+    )
+    tm.bind_task_to_session(scope, WORKER, PREVIOUS)
+    found = _prepare_merge(monkeypatch, session_id=WORKER, scope=scope)
+
+    merged = await sessions_route.execute_merge_session(
+        session_id=found.id,
+        expected_name=found.name,
+        expected_scope=found.scope,
+        expected_branch=found.branch,
+        expected_head=worker_head,
+        req={"scope": scope, "task_outcome": outcome, "merge_schema_version": 2},
+    )
+    assert merged["ok"] is True, merged
+    return repo, worktree, found
+
+
+async def _continued_worker(monkeypatch, tmp_path: Path):
+    """The reproduced state: merged with task_outcome=continue, branch equal to main."""
+    repo, worktree, found = await _merged_worker(monkeypatch, tmp_path, "continue")
+    assert _git(worktree.path, "rev-parse", "HEAD") == _git(repo, "rev-parse", "main")
+    return repo, worktree, found
+
+
+async def _switch(found, **extra):
+    import app.routes.sessions as sessions_route
+
+    return await sessions_route.switch_branch(
+        found.name, {"scope": found.scope, "task_id": NEXT, **extra},
+    )
+
+
+def _dump(result) -> str:
+    """The JSON body of a refusal, so an assertion failure shows the real reason."""
+    return getattr(result, "body", b"").decode() or str(result)
+
+
+@pytest.mark.asyncio
+async def test_merge_continue_then_switch_no_longer_clinches(monkeypatch, tmp_path):
+    """The reproduced clinch: switch used to die on the stale run of the old task."""
+    from app.db import get_session
+
+    repo, worktree, found = await _continued_worker(monkeypatch, tmp_path)
+    assert _task(PREVIOUS)["worker_session_id"] == found.id
+    assert [r["status"] for r in _open_runs(found.id)] == ["requested"]
+
+    result = await _switch(found)
+
+    assert isinstance(result, dict) and result["ok"] is True, _dump(result)
+    assert result["branch"] == f"task-{NEXT}/{WORKER}"
+    assert _git(worktree.path, "branch", "--show-current") == f"task-{NEXT}/{WORKER}"
+    assert result["previous_tasks"] == [{"task": PREVIOUS, "outcome": "requeued"}]
+    durable = get_session(found.id)
+    assert (durable["task_id"], durable["needs_switch"]) == (NEXT, 0)
+
+
+@pytest.mark.asyncio
+async def test_default_switch_releases_the_previous_task_into_the_queue(monkeypatch, tmp_path):
+    from app import tm
+
+    repo, worktree, found = await _continued_worker(monkeypatch, tmp_path)
+
+    result = await _switch(found)
+
+    assert result["ok"] is True, _dump(result)
+    previous, current = _task(PREVIOUS), _task(NEXT)
+    assert (previous["status"], previous["worker_session_id"]) == ("new", None)
+    assert (current["status"], current["worker_session_id"]) == ("in_progress", found.id)
+    assert [(r["task_id"], r["status"], r["failure_code"]) for r in _open_runs(found.id)] == [
+        (PREVIOUS, "interrupted", "binding_released"),
+        (NEXT, "requested", ""),
+    ]
+    # The released task is claimable again: it is a queue entry, not a lost one.
+    with tm._conn() as connection:
+        queued = [t["par_number"] for t in tm.list_tasks(connection, status="new")]
+    assert 5 in queued
+
+
+@pytest.mark.asyncio
+async def test_default_switch_leaves_the_task_to_a_second_live_worker(monkeypatch, tmp_path):
+    """Releasing one worker must not requeue a task another worker is still running."""
+    repo, worktree, found = await _continued_worker(monkeypatch, tmp_path)
+    _save_worker(
+        session_id="second-worker", task_id=PREVIOUS, scope=found.scope,
+        worktree_path="/other-worktree", branch=f"task-{PREVIOUS}/second-worker",
+    )
+
+    result = await _switch(found)
+
+    assert result["ok"] is True, _dump(result)
+    assert result["previous_tasks"] == [
+        {"task": PREVIOUS, "outcome": "handed_over", "heir": "second-worker"},
+    ]
+    previous = _task(PREVIOUS)
+    assert (previous["status"], previous["worker_session_id"]) == ("in_progress", "second-worker")
+
+
+@pytest.mark.asyncio
+async def test_force_does_not_change_the_outcome_on_a_settled_worker(monkeypatch, tmp_path):
+    repo, worktree, found = await _continued_worker(monkeypatch, tmp_path)
+
