+"""V-654: график «Квоты пула» по времени — линии факта и ось Красноярска.
+
+Фикстура — реальный ответ живого /api/usage/quota-map (форма не менялась): 169 точек
+anthropic, 171 codex, у codex_spark истории нет. Проверяется браузером и по тому, что
+линию реально видно: элемент под точкой линии — сама линия, а не что-то поверх.
+"""
+import copy
+import json
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+import pytest
+from playwright.sync_api import sync_playwright
+
+from tests.test_t344_quota_lines_browser import ROOT, _render
+
+FIXTURE = json.loads((ROOT / "tests/fixtures/quota_map_live_v654.json").read_text())
+SHOT_DIR = ROOT / ".orchestra/tasks/V-654"
+KRAT = timedelta(hours=7)
+PLOT_LEFT, PLOT_WIDTH, PLOT_TOP, PLOT_HEIGHT = 54, 886, 18, 408
+
+
+@pytest.fixture(scope="module")
+def browser():
+    with sync_playwright() as playwright:
+        instance = playwright.chromium.launch(headless=True)
+        yield instance
+        instance.close()
+
+
+def _open(browser, payload, width=924):
+    page, errors = _render(browser, payload)
+    page.set_viewport_size({"width": width, "height": 1400})
+    page.add_style_tag(content=".ql-body { max-height: none !important; overflow: visible !important; }")
+    return page, errors
+
+
+def _points(page, selector):
+    raw = page.locator(selector).first.get_attribute("points")
+    return [tuple(float(v) for v in pair.split(",")) for pair in raw.split()]
+
+
+def _y(util):
+    return PLOT_TOP + (1 - util / 100) * PLOT_HEIGHT
+
+
+def _now_x():
+    return PLOT_LEFT + PLOT_WIDTH / 2
+
+
+def test_fact_lines_are_drawn_for_every_pool_and_end_at_the_current_point(browser):
+    page, errors = _open(browser, copy.deepcopy(FIXTURE))
+    timeline = page.locator("[data-ql-timeline='all']")
+    for bucket, util in (("anthropic", 90.0), ("codex", 33.0)):
+        line = timeline.locator(f"[data-ql-timeline-history='{bucket}']")
+        assert line.count() >= 1, f"нет линии факта {bucket}"
+        pts = _points(page, f"[data-ql-timeline='all'] [data-ql-timeline-history='{bucket}']")
+        assert len(pts) > 100
+        assert all(PLOT_LEFT - 0.01 <= x <= PLOT_LEFT + PLOT_WIDTH + 0.01 for x, _ in pts)
+        assert all(PLOT_TOP - 0.01 <= y <= PLOT_TOP + PLOT_HEIGHT + 0.01 for _, y in pts)
+        assert pts[-1][0] == pytest.approx(_now_x(), abs=0.01)
+        assert pts[-1][1] == pytest.approx(_y(util), abs=0.01)
+        assert pts[0][0] < _now_x() - 300
+    assert timeline.locator("[data-ql-timeline-history='codex_spark']").count() == 0
+    assert errors == [], errors
+    page.close()
+
+
+def test_fact_line_is_on_top_and_really_visible(browser):
+    page, _ = _open(browser, copy.deepcopy(FIXTURE))
+    for bucket in ("anthropic", "codex"):
+        hit = page.evaluate(
+            """bucket => {
+                const line = document.querySelector(`[data-ql-timeline='all'] [data-ql-timeline-history='${bucket}']`);
+                const style = getComputedStyle(line);
+                const pts = line.getAttribute('points').split(' ').map(p => p.split(',').map(Number));
+                const mid = pts[Math.floor(pts.length / 2)];
+                const svg = line.ownerSVGElement, pt = svg.createSVGPoint();
+                pt.x = mid[0]; pt.y = mid[1];
+                const screen = pt.matrixTransform(line.getScreenCTM());
+                const top = document.elementFromPoint(screen.x, screen.y);
+                return {stroke: style.stroke, width: parseFloat(style.strokeWidth), opacity: parseFloat(style.opacity),
+                        onTop: top === line, topTag: top && (top.getAttribute('class') || top.tagName)};
+            }""",
+            bucket,
+        )
+        assert hit["stroke"] not in ("none", ""), hit
+        assert hit["width"] >= 2 and hit["opacity"] >= 0.9, hit
+        assert hit["onTop"], f"{bucket}: поверх линии {hit['topTag']}"
+    page.close()
+
+
+def test_codex_reset_inside_range_is_a_vertical_drop(browser):
+    page, _ = _open(browser, copy.deepcopy(FIXTURE))
+    pts = _points(page, "[data-ql-timeline='all'] [data-ql-timeline-history='codex']")
+    drops = [(a, b) for a, b in zip(pts, pts[1:]) if a[0] == b[0] and b[1] - a[1] > 300]
+    assert len(drops) == 1, "сброс окна codex (99% → ~0%) должен быть одним вертикальным шагом"
+    reset_ms = 1790433275 * 1000
+    now_ms = datetime.fromisoformat(FIXTURE["generated_at"]).timestamp() * 1000
+    expected_x = PLOT_LEFT + (reset_ms - (now_ms - 84 * 3600000)) / (168 * 3600000) * PLOT_WIDTH
+    assert drops[0][0][0] == pytest.approx(expected_x, abs=0.5)
+    page.close()
+
+
+def test_gap_in_telemetry_breaks_the_line_instead_of_bridging_it(browser):
+    payload = copy.deepcopy(FIXTURE)
+    bucket = next(b for b in payload["buckets"] if b["bucket"] == "anthropic")
+    points = bucket["timeline"]["points"]
+    bucket["timeline"]["points"] = points[:40] + points[100:]
+    page, _ = _open(browser, payload)
+    assert page.locator("[data-ql-timeline-history='anthropic']").count() == 2
+    page.close()
+
+
+def test_current_point_of_each_lane_is_on_the_center_line_and_visible(browser):
+    page, _ = _open(browser, copy.deepcopy(FIXTURE))
+    dots = page.locator("[data-ql-timeline='all'] [data-ql-timeline-point]")
+    seen = {dots.nth(i).get_attribute("data-ql-timeline-point"): dots.nth(i) for i in range(dots.count())}
+    assert set(seen) == {"luna", "sol", "claude"}
+    for lane, util in (("claude", 90.0), ("sol", 33.0), ("luna", 33.0)):
+        assert float(seen[lane].get_attribute("cx")) == pytest.approx(_now_x(), abs=0.01)
+        assert float(seen[lane].get_attribute("cy")) == pytest.approx(_y(util), abs=0.01)
+    assert float(seen["sol"].get_attribute("r")) != float(seen["luna"].get_attribute("r"))
+    page.close()
+
+
+def _expected_boundaries():
+    now = datetime.fromisoformat(FIXTURE["generated_at"])
+    lo, hi = now - timedelta(hours=84), now + timedelta(hours=84)
+    day = ((lo + KRAT).replace(hour=0, minute=0, second=0, microsecond=0)) - KRAT
+    found = []
+    while day <= hi:
+        for shift in (0, 8):
+            moment = day + timedelta(hours=shift)
+            if lo <= moment <= hi:
+                found.append(((moment + KRAT).strftime("%a"), shift))
+        day += timedelta(days=1)
+    return found
+
+
+def test_axis_has_two_hour_ticks_and_always_labels_night_boundaries_with_weekday(browser):
+    page, errors = _open(browser, copy.deepcopy(FIXTURE))
+    axis = page.locator("[data-ql-timeline='all']")
+    width = page.evaluate("document.querySelector('[data-ql-timeline] ').getBoundingClientRect().width")
+    assert 850 <= width <= 960, width
+    expected = _expected_boundaries()
+    labels = axis.locator("[data-ql-night-label]")
+    days = axis.locator("[data-ql-night-day]")
+    assert labels.count() == days.count() == len(expected) == 14
+    got = [(days.nth(i).text_content(), int(labels.nth(i).text_content()[:2])) for i in range(labels.count())]
+    assert got == expected
+    hours = [int(t.get_attribute("data-ql-tick")) for t in axis.locator("[data-ql-tick]").all()]
+    assert len(hours) == 84 and all(h % 2 == 0 for h in hours)
+    text_hours = [int(t.text_content()) for t in axis.locator("[data-ql-hour-label]").all()]
+    assert text_hours and all(h % 4 == 0 and h not in (0, 8) for h in text_hours)
+    assert len(text_hours) < len(hours) - len(expected)
+    assert errors == [], errors
+    page.close()
+
+
+def test_axis_labels_do_not_overlap_at_900px(browser):
+    page, _ = _open(browser, copy.deepcopy(FIXTURE))
+    boxes = page.evaluate(
+        """() => [...document.querySelectorAll('[data-ql-timeline] text')]
+            .filter(t => t.hasAttribute('data-ql-hour-label') || t.hasAttribute('data-ql-night-label') || t.hasAttribute('data-ql-night-day'))
+            .map(t => { const r = t.getBoundingClientRect(); return [r.left, r.right, r.top, r.bottom, t.textContent]; })"""
+    )
+    assert len(boxes) > 30
+    for i, a in enumerate(boxes):
+        for b in boxes[i + 1:]:
+            apart = a[1] <= b[0] + 0.5 or b[1] <= a[0] + 0.5 or a[3] <= b[2] + 0.5 or b[3] <= a[2] + 0.5
+            assert apart, f"подписи налезают: {a[4]!r} и {b[4]!r}"
+    svg = page.evaluate("(() => { const r = document.querySelector('[data-ql-timeline]').getBoundingClientRect(); return [r.left, r.right, r.bottom]; })()")
+    assert all(svg[0] - 0.5 <= a[0] and a[1] <= svg[1] + 0.5 and a[3] <= svg[2] + 0.5 for a in boxes)
+    page.close()
+
+
+def test_screenshot_on_live_shaped_data(browser):
+    page, _ = _open(browser, copy.deepcopy(FIXTURE))
+    SHOT_DIR.mkdir(parents=True, exist_ok=True)
+    page.locator("[data-ql-timeline='all']").screenshot(path=str(SHOT_DIR / "quota-timeline-live.png"))
+    page.close()
