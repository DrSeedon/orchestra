+// Ось времени Красноярска (UTC+7, без перехода на летнее): засечка каждые 2 часа, текст часа —
+// на каждой k-й засечке (k делит 4, чтобы 00:00 и 08:00 всегда попадали на подписанную
+// засечку), границы ночи 00:00/08:00 — отдельным рядом ниже, всегда, с днём недели.
+function _qlTimeAxis(x, from, to, locale) {
+    const base = _QL_MT + _QL_PH;
+    const tickPx = 2 * _QL_PW / ((to - from) / _QL_HOUR_MS);
+    const step = [1, 2, 4].find(k => k * tickPx >= _QL_HOUR_LABEL_PX) || 4;
+    const dayName = new Intl.DateTimeFormat(locale, {timeZone: 'Asia/Krasnoyarsk', weekday: 'short'});
+    const localHour = ts => new Date(ts + _QL_KRAT_OFFSET_MS).getUTCHours();
+    const out = [];
+    const first = Math.ceil((from + _QL_KRAT_OFFSET_MS) / (2 * _QL_HOUR_MS)) * 2 * _QL_HOUR_MS - _QL_KRAT_OFFSET_MS;
+    for (let ts = first; ts <= to; ts += 2 * _QL_HOUR_MS) {
+        const hour = localHour(ts);
+        const boundary = hour === 0 || hour === 8;
+        const labelled = (hour / 2) % step === 0;
+        const tx = x(ts);
+        out.push(`<line class="ql-tick" data-ql-tick="${hour}" x1="${tx}" y1="${base}" x2="${tx}" y2="${base + (labelled ? 6 : 3)}"/>`);
+        if (labelled && !boundary) {
+            out.push(`<text class="ql-axis" data-ql-hour-label="${hour}" x="${tx}" y="${base + 18}" text-anchor="middle">${String(hour).padStart(2, '0')}</text>`);
+        }
+    }
+    const firstDay = Math.floor((from + _QL_KRAT_OFFSET_MS) / (24 * _QL_HOUR_MS)) * 24 * _QL_HOUR_MS - _QL_KRAT_OFFSET_MS;
+    for (let day = firstDay; day <= to; day += 24 * _QL_HOUR_MS) {
+        for (const shift of [0, 8]) {
+            const ts = day + shift * _QL_HOUR_MS;
+            if (ts < from || ts > to) continue;
+            const tx = x(ts), hh = String(shift).padStart(2, '0');
+            out.push(`<line class="ql-grid ql-grid-night" x1="${tx}" y1="${_QL_MT}" x2="${tx}" y2="${base + 6}"/>`);
+            out.push(`<text class="ql-axis ql-axis-night" data-ql-night-label="${hh}:00" x="${tx}" y="${base + 31}" text-anchor="middle">${hh}:00</text>`);
+            out.push(`<text class="ql-axis ql-axis-night" data-ql-night-day="${hh}:00" x="${tx}" y="${base + 46}" text-anchor="middle">${_escHtml(dayName.format(new Date(ts + 1)))}</text>`);
+        }
+    }
+    return out;
+}
+
+// Фактическая линия расхода полосы за [from, now]. Разрыв в данных (> 6 ч) рвёт линию: молчаливая
+// прямая через дыру телеметрии соврала бы «расход шёл». Сброс окна — вертикальный шаг в момент
+// старого resets_at, а не косой отрезок через интервал между снимками.
+function _qlHistorySegments(bucket, from, now) {
+    const raw = (bucket.timeline?.points || [])
+        .map(point => ({ts: Number(point.ts) * 1000, util: Number(point.utilization), reset: Number(point.resets_at) * 1000}))
+        .filter(point => Number.isFinite(point.ts) && Number.isFinite(point.util) && point.ts >= from && point.ts <= now)
+        .sort((a, b) => a.ts - b.ts);
+    const segments = [];
+    let current = [], prev = null;
+    for (const point of raw) {
+        if (prev && point.ts - prev.ts > _QL_HISTORY_GAP_MS) {
+            segments.push(current);
+            current = [];
+        } else if (prev && Number.isFinite(prev.reset) && Number.isFinite(point.reset)
+                && Math.abs(point.reset - prev.reset) > _QL_HOUR_MS
+                && prev.reset > prev.ts && prev.reset <= point.ts) {
+            current.push([prev.reset, prev.util], [prev.reset, point.util]);
+        }
+        current.push([point.ts, point.util]);
+        prev = point;
+    }
+    const live = _qlPoint(bucket);
+    if (live) current.push([now, live.util]);
+    segments.push(current);
+    return segments.filter(segment => segment.length > 1);
+}
