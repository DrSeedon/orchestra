     page.close()
 
 
+LIVE_FIXTURE = ROOT / "tests/fixtures/v654_quota_map_live_shape.json"
+
+
+def test_timeline_draws_the_full_actual_line_on_a_live_shaped_fixture(browser):
+    """#V-654: owner saw no actual-usage line left of center on the live dashboard,
+    only forecast diagonals, plus one lane's current point looked absent.
+
+    Root causes fixed here, reproduced on a fixture shaped exactly like a captured
+    live `/api/usage/quota-map` response (169/171 raw timeline points per bucket):
+    - the 2h/4h axis-tick loop aligned to UTC hours instead of Krasnoyarsk (+7)
+      ones, so `isFourHour`/`isBoundary` never matched and the whole tick loop
+      silently drew nothing;
+    - Luna and Sol share one bucket window, so the bucket-colored trace line only
+      ever matched ONE of the two lanes' colors — the other lane had no actual
+      line in its own color anywhere on the chart;
+    - the current-point circles were drawn BEFORE the actual trace and the `now`
+      line, so the trace's own last segment (ending at that exact pixel) painted
+      over the circle, most visibly for a lane sitting right on its threshold.
+
+    This must go red if any of those regress: the trace disappearing, only a
+    handful of points surviving, a lane's line reverting to invisible, or the
+    axis labels going back to zero / overlapping each other.
+    """
+    payload = json.loads(LIVE_FIXTURE.read_text())
+    page, errors = _render(browser, payload)
+    timeline = page.locator("[data-ql-timeline='all']")
+
+    # 1) The actual-usage line must span most of the past 3.5 days, not just the
+    #    handful of points near "now" that a broken from/to filter would leave.
+    for bucket, min_points in (("anthropic", 150), ("codex", 150)):
+        points_attr = timeline.locator(f"[data-ql-timeline-history='{bucket}']").get_attribute("points")
+        assert points_attr, f"{bucket}: no actual-usage polyline at all"
+        coords = points_attr.strip().split(" ")
+        assert len(coords) >= min_points, (bucket, len(coords))
+        xs = [float(c.split(",")[0]) for c in coords]
+        assert min(xs) < 100, "history must start near the left edge, not just at 'now'"
+        assert max(xs) == pytest.approx(497.0, abs=1.0), "history must reach the 'now' line"
+
+    # 2) Luna and Sol share the codex bucket's window; each must still get its own
+    #    line in its own color, or Luna's "actual result" is invisible by color.
+    luna_line = timeline.locator("[data-ql-timeline-lane='luna']")
+    sol_line = timeline.locator("[data-ql-timeline-lane='sol']")
+    assert luna_line.count() == 1 and sol_line.count() == 1
+    assert "38bdf8" in (luna_line.get_attribute("style") or "")
+    assert "f472b6" in (sol_line.get_attribute("style") or "")
+
+    # 3) Every known lane gets a current point exactly on the "now" line, and the
+    #    circle must be the LAST element painted at that pixel (not a line ending
+    #    on top of it) so it stays visible even sitting on its own threshold.
+    now_x = float(timeline.locator(".ql-now").get_attribute("x1"))
+    for lane in ("claude", "sol", "luna"):
+        circle = timeline.locator(f"[data-ql-timeline-point='{lane}']")
+        assert circle.count() == 1, lane
+        assert float(circle.get_attribute("cx")) == pytest.approx(now_x, abs=0.5)
+    all_marks = page.evaluate(
+        "sel => [...document.querySelectorAll(sel)].map(n => n.outerHTML)",
+        "[data-ql-timeline='all'] > *",
+    )
+    point_positions = [i for i, html in enumerate(all_marks) if "data-ql-timeline-point" in html]
+    trace_positions = [i for i, html in enumerate(all_marks) if "data-ql-timeline-history" in html
+                        or "data-ql-timeline-lane" in html or html.startswith("<line class=\"ql-now")]
+    assert point_positions and trace_positions
+    assert min(point_positions) > max(trace_positions), "current-point circles must be drawn last"
+
+    # 4) X-axis: a 2h notch everywhere, a labeled mark every 4h, night boundaries
+    #    (00:00/08:00 Krasnoyarsk) always named with their weekday, nothing overlaps.
+    assert timeline.locator(".ql-tick").count() >= 40
+    boundary_labels = timeline.locator(".ql-axis-night")
+    assert boundary_labels.count() >= 10
+    boxes = page.evaluate(
+        """() => [...document.querySelectorAll("[data-ql-timeline='all'] text.ql-axis")]
+            .filter(t => parseFloat(t.getAttribute('y')) > 400)
+            .map(t => { const b = t.getBBox(); return {x: b.x, y: b.y, w: b.width, h: b.height}; })"""
+    )
+    assert len(boxes) >= 15
+    for i, a in enumerate(boxes):
+        for b in boxes[i + 1:]:
+            overlap = not (a["x"] + a["w"] <= b["x"] or b["x"] + b["w"] <= a["x"]
+                           or a["y"] + a["h"] <= b["y"] or b["y"] + b["h"] <= a["y"])
+            assert not overlap, (a, b)
+
+    assert errors == [], errors
+    page.evaluate("""() => {
+        const body = document.querySelector('.ql-body');
+        body.style.maxHeight = 'none';
+        body.style.overflow = 'visible';
+    }""")
+    page.add_style_tag(content=".ql-body { max-height: none !important; overflow: visible !important; }")
+    screenshot_dir = ROOT / ".orchestra/tasks/V-654"
+    screenshot_dir.mkdir(parents=True, exist_ok=True)
+    page.set_viewport_size({"width": 1280, "height": 1600})
+    page.screenshot(path=str(screenshot_dir / "quota-timeline-live.png"), full_page=True)
+    page.close()
+
