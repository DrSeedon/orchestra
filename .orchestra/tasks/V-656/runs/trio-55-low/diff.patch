+def _has_attention_events(database) -> bool:
+    with sqlite3.connect(database) as connection:
+        return connection.execute(
+            "SELECT 1 FROM sqlite_master WHERE name='attention_events'"
+        ).fetchone() is not None
+
+
+@pytest.mark.parametrize("user_version", [2, 3])
+def test_migration_creates_missing_attention_events_idempotently(
+    tmp_path, monkeypatch, user_version,
+):
+    from app.startup_migration import _migrate_database
+
+    database = tmp_path / "orchestra.db"
+    monkeypatch.setattr(db, "DB_PATH", database)
+    db.init_db()
+    with sqlite3.connect(database) as connection:
+        connection.execute("DROP TABLE attention_events")
+        if user_version == 2:
+            connection.execute("ALTER TABLE tm_tasks DROP COLUMN tags")
+        connection.execute(f"PRAGMA user_version={user_version}")
+    assert not _has_attention_events(database)
+
+    _migrate_database(database)
+    assert _has_attention_events(database)
+    _migrate_database(database)  # already there (e.g. created by hand)
+    assert _has_attention_events(database)
