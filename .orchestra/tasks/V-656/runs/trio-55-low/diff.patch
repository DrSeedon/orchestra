index 00000000..5226109c
--- /dev/null
+++ b/tests/test_precompact_remove_v653.py
@@ -0,0 +1,26 @@
+"""V-653: удаление воркера отменяет таймер предкомпакта."""
+import asyncio
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+
+@pytest.mark.asyncio
+async def test_remove_cancels_precompact_timer(monkeypatch):
+    import app.manager as manager_module
+
+    session = MagicMock()
+    session.name = "w"
+    session.loaded = False
+    session.worktree_path = None
+    session.scope = "/s"
+    mgr = manager_module.SessionManager.__new__(manager_module.SessionManager)
+    mgr.sessions = {"sid": session}
+    mgr._cleanup_cli_home = MagicMock()
+    monkeypatch.setattr(manager_module, "archive_session", MagicMock())
+    monkeypatch.setattr("app.bg_jobs.bg_manager", MagicMock(cancel_by_session=AsyncMock()))
+    monkeypatch.setattr("app.fan_barrier.on_child_killed", MagicMock())
+
+    await mgr.remove("sid")
+
+    session._cancel_precompact_timer.assert_called_once()
