@@ -0,0 +1,315 @@
+"""V-620: a worker held by a finished `continue` merge must be releasable by a switch.
+
+The clinch: after merge_worker(task_outcome="continue") with no further commits the worker
+branch equals main, so merge_worker refuses another merge, and switch_worker_branch used to
+die on the still-open task run of the old task. The switch now closes that binding itself,
+but only when Git shows nothing of the worker left behind.
+"""
+
+from tests.task_seeds import create_task as seed_task
+
+import subprocess
+from pathlib import Path
+
+import pytest
+from fastapi.responses import JSONResponse
+
+from tests.test_task_tracker_integration import (
+    _commit_file,
+    _init_db,
+    _make_git_scope,
+    _prepare_merge,
+    _save_worker,
+)
+
+NAME = "held-worker"
+
+
+def _git(path, *args: str) -> str:
+    return subprocess.run(
+        ["git", *args], cwd=path, check=True, capture_output=True, text=True,
+    ).stdout.strip()
+
+
+def _open_run(tm, task_id: int, session_id: str) -> None:
+    with tm._conn() as connection:
+        tm._open_task_run_for_task(
+            connection, tm.get_task_by_id(connection, task_id), session_id,
+        )
+
+
+def _runs(session_id: str) -> list[dict]:
+    from app import tm
+
+    with tm._conn() as connection:
+        rows = connection.execute(
+            "SELECT task_id,status,failure_code FROM review_receipts "
+            "WHERE subject_kind='task_run' AND session_id=? ORDER BY requested_at",
+            (session_id,),
+        ).fetchall()
+    return [dict(row) for row in rows]
+
+
+def _task(task_db_id: int) -> dict:
+    from app import tm
+
+    with tm._conn() as connection:
+        return tm.get_task_by_id(connection, task_db_id)
+
+
+def _holding_worker(monkeypatch, tmp_path: Path):
+    """A worker on task 42 with an open run, branch tip equal to main, tree clean."""
+    import app.workspace as workspace
+    from app import tm
+
+    _init_db()
+    repo = _make_git_scope(monkeypatch, tmp_path)
+    scope = str(repo)
+    with tm._conn() as connection:
+        tm.ensure_project(connection, "project", scope=scope)
+        held = seed_task(
+            connection, "project", "Held", par_number=42, status="in_progress",
+        )
+        nxt = seed_task(connection, "project", "Next", par_number=43, status="new")
+        connection.execute(
+            "UPDATE tm_tasks SET worker_session_id=? WHERE id=?", (NAME, held["id"]),
+        )
+    worktree = workspace.create_worktree(scope, NAME, task_id="42")
+    _save_worker(
+        session_id=NAME, task_id="42", scope=scope,
+        worktree_path=worktree.path, branch=worktree.branch,
+    )
+    found = _prepare_merge(monkeypatch, session_id=NAME, scope=scope)
+    _open_run(tm, held["id"], NAME)
+    return repo, worktree, found, held, nxt
+
+
+async def _switch(found, scope: str, **extra):
+    import app.routes.sessions as sessions_route
+
+    return await sessions_route.switch_branch(
+        found.name, {"scope": scope, "task_id": "43", **extra},
+    )
+
+
+def _assert_still_held(held, worktree, branch_before: str) -> None:
+    from app.db import get_session
+
+    row = _task(held["id"])
+    assert (row["status"], row["worker_session_id"]) == ("in_progress", NAME)
+    assert [r["status"] for r in _runs(NAME)] == ["requested"]
+    assert _git(worktree.path, "branch", "--show-current") == branch_before
+    assert get_session(NAME)["task_id"] == "42"
+
+
+@pytest.mark.asyncio
+async def test_real_continue_merge_then_switch_releases_the_worker(monkeypatch, tmp_path):
+    """The reported clinch, through real Git: continue merge leaves branch == main."""
+    import app.routes.sessions as sessions_route
+    from app import tm
+    from app.db import get_session
+
+    repo, worktree, found, held, nxt = _holding_worker(monkeypatch, tmp_path)
+    worker_head = _commit_file(worktree.path, "phase1.txt", "#42: phase one")
+    merged = await sessions_route.execute_merge_session(
+        session_id=found.id, expected_name=found.name, expected_scope=found.scope,
+        expected_branch=found.branch, expected_head=worker_head,
+        req={"scope": found.scope, "task_outcome": "continue", "merge_schema_version": 2},
+    )
+    assert merged["ok"] is True, merged
+    assert _git(worktree.path, "rev-parse", "HEAD") == _git(repo, "rev-parse", "main")
+    assert _task(held["id"])["worker_session_id"] == NAME
+
+    result = await _switch(found, found.scope)
+
+    assert result["ok"] is True, result
+    assert result["previous_task"]["outcome"] == "release"
+    old, new = _task(held["id"]), _task(nxt["id"])
+    assert (old["status"], old["worker_session_id"]) == ("new", None)
+    assert (new["status"], new["worker_session_id"]) == ("in_progress", NAME)
+    assert get_session(NAME)["task_id"] == "43"
+    runs = {r["task_id"]: r for r in _runs(NAME)}
+    assert (runs["42"]["status"], runs["42"]["failure_code"]) == (
+        "interrupted", "released_by_switch",
+    )
+    assert runs["43"]["status"] == "requested"
+    assert tm.held_task_binding(found.scope, NAME, "42") is None
+
