+@pytest.mark.asyncio
+async def test_failed_assignment_keeps_the_previous_binding_intact(monkeypatch, tmp_path):
+    """Release and assignment are one transaction: a raise in between undoes both."""
+    from app import tm
+
+    _repo, worktree, found, held, nxt = _holding_worker(monkeypatch, tmp_path)
+    branch_before = _git(worktree.path, "branch", "--show-current")
+    real_open = tm._open_task_run_for_task
+
+    def open_fails_for_new_task(conn, task, session_id):
+        if task["id"] == nxt["id"]:
+            raise RuntimeError("injected run failure")
+        return real_open(conn, task, session_id)
+
+    monkeypatch.setattr(tm, "_open_task_run_for_task", open_fails_for_new_task)
+
+    result = await _switch(found, found.scope)
+
+    assert result["ok"] is False and result["state"] == "task_assignment_failed"
+    _assert_still_held(held, worktree, branch_before)
+    assert _task(nxt["id"])["worker_session_id"] is None
+
