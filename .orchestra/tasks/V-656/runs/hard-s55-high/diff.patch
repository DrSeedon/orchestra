+def held_task_binding(scope: str, session_id: str, task_ref: str) -> dict | None:
+    """The task a worker still holds on the tracker side, or None if it holds none.
+
+    Reads only: the switch route uses it to decide, before Git moves, whether an
+    idle worker on a finished-looking task can be released.
+    """
+    task_ref = str(task_ref or "").strip()
+    if not task_ref:
+        return None
+    with active_runtime().operation():
+        with _conn() as conn:
+            project = get_project_by_scope(conn, scope.rstrip("/"))
+            try:
+                task = resolve_task_ref(conn, task_ref, project["id"]) if project else None
+            except ValueError:
+                task = None
+            if not task or str(task["worker_session_id"] or "") != session_id:
+                return None
+            open_run = conn.execute(
+                "SELECT 1 FROM review_receipts WHERE subject_kind='task_run' "
+                "AND session_id=? AND task_id=? AND status='requested'",
+                (session_id, public_task_ref(task)),
+            ).fetchone()
+        return {
+            "task_id": task["id"],
+            "ref": public_task_ref(task),
+            "status": task["status"],
+            "has_open_run": open_run is not None,
+        }
+
+
+RELEASE_PREVIOUS_OUTCOMES = frozenset({"release", "done"})
+
+
+def _release_previous_task(conn: sqlite3.Connection, spec: dict, session_id: str) -> dict:
+    """Detach a worker from the task it held, inside the caller's transaction.
+
+    ``release`` returns an unfinished task to the queue and ends the run as
+    interrupted; ``done`` closes the task and completes the run. Either way the
+    worker/task link and the open receipt disappear together, so the next
+    assignment of the same worker cannot meet a stale run.
+    """
+    outcome = spec.get("outcome")
+    if outcome not in RELEASE_PREVIOUS_OUTCOMES:
+        raise ValueError(f"unknown previous task outcome '{outcome}'")
+    if str(spec.get("session_id") or "") != session_id:
+        raise ValueError("previous task release belongs to a different worker")
+    task = get_task_by_id(conn, spec["task_id"])
+    if not task or str(task["worker_session_id"] or "") != session_id:
+        raise ValueError("previous task is no longer bound to this worker")
+    if outcome == "done":
+        if task["status"] == "cancelled":
+            raise ValueError("previous task is cancelled and cannot be closed as done")
+        update_task(conn, task["id"], status="done")
+    elif task["status"] == "in_progress":
+        update_task(conn, task["id"], status="new")
+    conn.execute(
+        "UPDATE tm_tasks SET worker_session_id=NULL, "
+        "sync_revision=sync_revision+1, updated_at=? WHERE id=?",
+        (_now(), task["id"]),
+    )
+    _finish_task_run_for_task(
+        conn,
+        task,
+        session_id,
+        status="completed" if outcome == "done" else "interrupted",
+        failure_code="" if outcome == "done" else "released_by_switch",
+    )
+    active_runtime().publish(conn, task["id"])
+    return {"ref": public_task_ref(task), "outcome": outcome}
+
