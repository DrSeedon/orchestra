+class TestRemoveStopsPrecompactTimer:
+    """Убитый воркер не сжимается: таймер предкомпакта взведён его последним ходом."""
+
+    DELAY = 0.2
+
+    async def create(self, mgr, name, backend):
+        from app.session import AgentStatus
+        session = await mgr.create_session(
+            name=name, scope="/s", cwd="/tmp", model="claude-sonnet-5[1m]",
+        )
+        session.backend_type = backend
+        session.status = AgentStatus.IDLE
+        session._last_context["percentage"] = 70
+        session.compact = AsyncMock(return_value={"ok": True})
+        session.PRECOMPACT_DELAY_SECONDS = self.DELAY
+        session.CODEX_PRECOMPACT_DELAY_SECONDS = self.DELAY
+        return session
+
+    def arm(self, session):
+        session._schedule_precompact_timer(70)
+        assert session._precompact_timer is not None
+        return session
+
+    async def armed(self, mgr, name, backend):
+        return self.arm(await self.create(mgr, name, backend))
+
+    @pytest.mark.asyncio
+    @pytest.mark.parametrize("backend", ["codex", "claude"])
+    async def test_killed_session_timer_never_fires_while_live_one_compacts(self, mgr, backend):
+        killed = await self.create(mgr, "killed", backend)
+        alive = await self.create(mgr, "alive", backend)
+        self.arm(killed)
+        self.arm(alive)
+
+        await mgr.remove(killed.id)
+        await asyncio.sleep(self.DELAY * 3)
+
+        killed.compact.assert_not_awaited()
+        assert killed._precompact_timer is None and killed._precompact_timer_task is None
+        alive.compact.assert_awaited_once_with()
+
+    @pytest.mark.asyncio
+    async def test_timer_is_cancelled_before_the_first_await_of_remove(self, mgr):
+        session = await self.armed(mgr, "doomed", "codex")
+        task = session._precompact_timer_task
+        seen = []
+
+        async def cancel_by_session(_session_id):
+            seen.append((task.cancelling() > 0, session._precompact_timer))
+
+        with patch("app.bg_jobs.bg_manager.cancel_by_session", side_effect=cancel_by_session):
+            await mgr.remove(session.id)
+
+        assert seen == [(True, None)]
+
+    @pytest.mark.asyncio
+    async def test_removed_session_cannot_rearm_or_compact_after_a_late_turn_end(self, mgr):
+        session = await self.armed(mgr, "late-turn", "codex")
+        session._ensure_backend = AsyncMock(side_effect=FileNotFoundError("worktree removed"))
+        real_compact = type(session).compact
+
+        await mgr.remove(session.id)
+        session._schedule_precompact_timer(70)
+        await asyncio.sleep(self.DELAY * 2)
+        result = await real_compact(session)
+
+        assert session._precompact_timer is None and session._precompact_timer_task is None
+        session.compact.assert_not_awaited()
+        assert result["ok"] is False
+        session._ensure_backend.assert_not_awaited()
+
+    @pytest.mark.asyncio
+    async def test_failed_remove_leaves_the_session_compactable(self, mgr):
+        session = await self.armed(mgr, "survivor", "codex")
+        session._disconnect_backend = AsyncMock(side_effect=RuntimeError("still alive"))
+
+        with pytest.raises(RuntimeError, match="still alive"):
+            await mgr.remove(session.id)
+        session._schedule_precompact_timer(70)
+        await asyncio.sleep(self.DELAY * 3)
+
+        assert session.id in mgr.sessions
+        session.compact.assert_awaited_once_with()
