+def bg_cron_timeout_notified(job_id: str) -> bool:
+    job = bg_get_job(job_id)
+    try:
+        return bool(job and json.loads(job["config"]).get("timeout_notified_at"))
+    except (json.JSONDecodeError, TypeError, AttributeError):
+        return False
+
+
+def bg_cron_set_timeout_notified(job_id: str, notified: bool) -> None:
+    # Флаг лежит в config, а не в памяти: рестарт не должен снова будить цель по тому же таймауту.
+    if bg_cron_timeout_notified(job_id) == notified:
+        return
+    with _conn() as c:
+        c.execute("BEGIN IMMEDIATE")
+        row = c.execute("SELECT config, status FROM bg_jobs WHERE id=?", (job_id,)).fetchone()
+        if not row or row["status"] != "active":
+            c.execute("ROLLBACK")
+            return
+        try:
+            cfg = json.loads(row["config"])
+        except (json.JSONDecodeError, TypeError):
+            cfg = {}
+        if notified:
+            cfg["timeout_notified_at"] = datetime.now(timezone.utc).isoformat()
+        else:
+            cfg.pop("timeout_notified_at", None)
+        c.execute(
+            "UPDATE bg_jobs SET config=? WHERE id=? AND status='active'",
+            (json.dumps(cfg), job_id),
+        )
+        c.execute("COMMIT")
+
