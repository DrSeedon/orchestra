+def _attention_events_sql(database):
+    """Нормализованный DDL таблицы или None; сравнивать можно с чужой базой."""
+    with sqlite3.connect(database) as connection:
+        row = connection.execute(
+            "SELECT sql FROM sqlite_master WHERE type='table' AND name='attention_events'"
+        ).fetchone()
+    return None if row is None else " ".join(row[0].split())
+
+
+def _fresh_install_attention_events_sql(tmp_path):
+    fresh = tmp_path / "fresh-install.db"
+    db.init_db(fresh)
+    return _attention_events_sql(fresh)
+
+
+def _drop_attention_events(database):
+    with sqlite3.connect(database) as connection:
+        connection.execute("DROP TABLE attention_events")
+
+
+def _orchestrator_row(session_id):
+    return {
+        "id": session_id, "name": session_id, "scope": "/attention", "cwd": "/attention",
+        "model": "test", "system_prompt": "", "status": "idle", "session_id": None,
+        "cost_usd": 0.0, "worktree_path": "", "branch": "", "base_branch": "main",
+        "needs_switch": 0, "is_orchestrator": True, "color": "", "role": "orchestrator",
+        "parent_id": "", "parent_name": "",
+        "created_at": "2026-09-01T00:00:00+00:00", "finished_at": None,
+    }
+
+
+def test_v2_database_gets_attention_events_from_the_migration(legacy_install, tmp_path):
+    """V-653: у базы v2 таблицы нет — `notify_user` падал `no such table` 22–28.09."""
+    database, root, _records = legacy_install
+    _drop_attention_events(database)
+    assert _attention_events_sql(database) is None
+
+    result = migrate_v576(database, root)
+
+    assert result["state"] == "migrated"
+    assert _attention_events_sql(database) == _fresh_install_attention_events_sql(tmp_path)
+    db.save_session(_orchestrator_row("orch-653"))
+    from app import attention
+
+    event = attention.create_attention("orch-653", "миграция довела схему", kind="incident")
+    assert attention.get_attention_event(event["event_id"])["reason"] == "миграция довела схему"
+
+
+def test_database_migrated_before_the_fix_is_repaired_on_start(legacy_install, tmp_path):
+    """VPS и ноутбук уже на v3 без таблицы: миграция «ничего не ждёт», а таблицы нет."""
+    database, root, _records = legacy_install
+    migrate_v576(database, root)
+    _drop_attention_events(database)
+    head = _head(root)
+
+    repaired = migrate_v576(database, root)
+
+    assert repaired == {"state": "repaired", "attention_events": "created"}
+    assert _attention_events_sql(database) == _fresh_install_attention_events_sql(tmp_path)
+    assert _head(root) == head
+    assert migrate_v576(database, root) == {"state": "already"}
+
+
+def test_hand_created_attention_events_keeps_its_rows(legacy_install):
+    """28.09 таблицу создали вручную той же DDL: миграция её не пересоздаёт и не чистит."""
+    database, root, _records = legacy_install
+    with sqlite3.connect(database) as connection:
+        connection.execute(
+            "INSERT INTO attention_events(id,kind,reason,source_session_id,created_at) "
+            "VALUES('manual-1','incident','создано руками','orch','2026-09-28T00:00:00+00:00')"
+        )
+    before = _attention_events_sql(database)
+
+    assert migrate_v576(database, root)["state"] == "migrated"
+    assert migrate_v576(database, root) == {"state": "already"}
+
+    assert _attention_events_sql(database) == before
+    with sqlite3.connect(database) as connection:
+        assert connection.execute("SELECT id, reason FROM attention_events").fetchall() == [
+            ("manual-1", "создано руками"),
+        ]
+
+
+def test_an_empty_database_file_is_left_for_init_db(tmp_path):
+    """Пустой файл базы не «мигрированная база»: таблица до init_db заставила бы его отказаться."""
+    empty = tmp_path / "empty.db"
+    sqlite3.connect(empty).close()
+    root = tmp_path / "tasks"
+    root.mkdir()
+
+    assert migrate_v576(empty, root) == {"state": "already"}
+
+    db.init_db(empty)
+    assert _attention_events_sql(empty) is not None
