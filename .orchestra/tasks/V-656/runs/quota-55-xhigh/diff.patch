+def _axis_texts(page) -> list[dict]:
+    return page.evaluate("""() => {
+        const svg = document.querySelector('[data-ql-timeline]');
+        const box = svg.getBoundingClientRect();
+        const ctm = svg.getScreenCTM();
+        const bottom = ctm.d * (18 + 408) + ctm.f;
+        return [...svg.querySelectorAll('text')].map(el => ({rect: el.getBoundingClientRect().toJSON(), text: el.textContent,
+            kind: el.dataset.qlTickLabel ? 'hour' : el.dataset.qlNightWeekday ? 'weekday' : 'other',
+            ts: el.dataset.qlTickLabel || el.dataset.qlNightWeekday || null}))
+            .filter(t => t.rect.top >= bottom)
+            .map(t => ({...t, svgLeft: box.left, svgRight: box.right}));
+    }""")
+
+
+@pytest.mark.parametrize("lang,width", [("ru", 900), ("en", 900), ("ru", 1256), ("ru", 360)])
+def test_axis_has_two_hour_ticks_and_night_borders_and_nothing_overlaps(browser, lang, width):
+    payload = _live()
+    now = _now_ms(payload)
+    from_ms, to_ms = now - HALF_MS, now + HALF_MS
+    page, errors = _open(browser, payload, lang, width)
+
+    def local(ms: int) -> datetime:
+        return datetime.fromtimestamp(ms / 1000, KRAT)
+
+    hour_ms = 3600 * 1000
+    first_hour = -(-int(from_ms) // hour_ms) * hour_ms
+    expected_ticks = [t for t in range(first_hour, int(to_ms) + 1, hour_ms) if local(t).hour % 2 == 0]
+    ticks = page.locator("[data-ql-tick]")
+    assert ticks.count() == len(expected_ticks) == 84
+    for i, t in enumerate(expected_ticks):
+        assert float(ticks.nth(i).get_attribute("x1")) == pytest.approx(_x(t, now))
+
+    texts = _axis_texts(page)
+    hours = {int(t["ts"]): t["text"] for t in texts if t["kind"] == "hour"}
+    weekdays = {int(t["ts"]): t["text"] for t in texts if t["kind"] == "weekday"}
+    borders = [t for t in expected_ticks if local(t).hour in (0, 8)]
+    assert len(borders) >= 14
+    for t in borders:
+        assert hours[t] == f"{local(t).hour:02d}"
+        assert weekdays[t] == WEEKDAYS[lang][local(t).weekday()]
+    assert set(weekdays) == set(borders), "weekday only on night borders"
+    regular = {t for t in hours if t not in borders}
+    assert regular == {t for t in expected_ticks if local(t).hour % 4 == 0 and t not in borders}, \
+        "hour text on every second tick when every tick does not fit"
+    assert all(local(t).hour % 2 == 0 for t in hours)
+
+    for i, a in enumerate(texts):
+        assert a["rect"]["left"] >= a["svgLeft"] - 0.5 and a["rect"]["right"] <= a["svgRight"] + 0.5
+        for b in texts[i + 1:]:
+            apart = (a["rect"]["right"] <= b["rect"]["left"] or b["rect"]["right"] <= a["rect"]["left"]
+                     or a["rect"]["bottom"] <= b["rect"]["top"] or b["rect"]["bottom"] <= a["rect"]["top"])
+            assert apart, f"axis labels overlap: {a['text']!r} and {b['text']!r}"
+    assert errors == [], errors
+    if os.environ.get("V654_SCREENSHOT") and (lang, width) == ("ru", 900):
+        SCREENSHOT.parent.mkdir(parents=True, exist_ok=True)
+        page.locator(".ql-panel").screenshot(path=str(SCREENSHOT))
+    page.close()
+
