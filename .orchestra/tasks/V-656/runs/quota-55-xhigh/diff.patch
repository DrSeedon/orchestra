+    payload = _live()
+    payload["generated_at"] = "2026-09-29T09:00:00+00:00"
+    now = _now_ms(payload)
+    reset_new = datetime(2026, 10, 6, 7, 0, tzinfo=timezone.utc).timestamp()
+    reset_old = datetime(2026, 9, 29, 7, 0, tzinfo=timezone.utc).timestamp()
+    claude = _bucket(payload, "anthropic")
+    assert len({s["resets_at"] for s in claude["timeline"]["points"]}) > 50, "fixture must carry the jitter"
+    for i, util in enumerate((1.0, 2.0, 4.0)):
+        claude["timeline"]["points"].append({"ts": reset_old + 300 + i * 1800, "utilization": util,
+                                             "resets_at": reset_new, "window_minutes": 10080})
+    claude["window"].update(utilization=4.0, resets_at="2026-10-06T07:00:00+00:00",
+                            starts_at="2026-09-29T07:00:00+00:00", progress=0.01)
+    page, _ = _open(browser, payload)
+    assert page.locator("[data-ql-timeline-threshold='claude']").count() == 2
+    points = _polyline(page, "anthropic")
+    step = [(a, b) for a, b in zip(points, points[1:]) if a[0] == pytest.approx(b[0]) and b[1] - a[1] > 300]
+    assert len(step) == 1
+    assert step[0][0][0] == pytest.approx(_x(reset_old * 1000, now), abs=0.5)
+    page.close()
