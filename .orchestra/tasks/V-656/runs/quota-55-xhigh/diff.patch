+"""V-654: график «Квоты пула» по времени на форме ЖИВОГО ответа /api/usage/quota-map.
+
+Фикстура `tests/fixtures/quota_map_live_v654.json` — ответ боевого API от 28.09.2026
+(169 точек Claude, 171 точка Codex, сброс окна Codex внутри диапазона), без правок формы.
+Проверяется браузером: линии факта, ступенька сброса, кольца текущих точек и подписи оси X.
+"""
+import copy
+import json
+import os
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+import pytest
+from playwright.sync_api import Browser, sync_playwright
+
+ROOT = Path(__file__).parent.parent
+FIXTURE = ROOT / "tests/fixtures/quota_map_live_v654.json"
+SCREENSHOT = ROOT / ".orchestra/tasks/V-654/quota-timeline.png"
+SCRIPTS = [
+    *[ROOT / f"app/static/css/vendor/{name}" for name in
+      ("marked.min.js", "purify.min.js", "diff_match_patch.js", "highlight.min.js")],
+    *[ROOT / f"app/static/js/{name}" for name in
+      ("i18n.js", "utils.js", "quota-lines.js", "connection.js", "app.js")],
+]
+STYLE_CSS = ROOT / "app/static/css/style.css"
+
+PLOT_X, PLOT_W, PLOT_Y, PLOT_H = 54.0, 886.0, 18.0, 408.0
+HALF_MS = 84 * 3600 * 1000
+KRAT = timezone(timedelta(hours=7))
+WEEKDAYS = {"ru": ["пн", "вт", "ср", "чт", "пт", "сб", "вс"],
+            "en": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]}
+
+
+@pytest.fixture(scope="module")
+def browser():
+    with sync_playwright() as playwright:
+        instance = playwright.chromium.launch(headless=True)
+        yield instance
+        instance.close()
+
+
+def _live() -> dict:
+    return json.loads(FIXTURE.read_text())
+
+
+def _now_ms(payload: dict) -> float:
+    return datetime.fromisoformat(payload["generated_at"]).timestamp() * 1000
+
+
+def _x(ts_ms: float, now_ms: float) -> float:
+    return PLOT_X + (ts_ms - (now_ms - HALF_MS)) / (2 * HALF_MS) * PLOT_W
+
+
+def _y(pct: float) -> float:
+    return PLOT_Y + (1 - pct / 100) * PLOT_H
+
+
+def _bucket(payload: dict, name: str) -> dict:
+    return next(b for b in payload["buckets"] if b["bucket"] == name)
+
+
+def _open(browser: Browser, payload: dict, lang: str = "ru", width: int = 900):
+    errors: list = []
+    page = browser.new_page(viewport={"width": 1400, "height": 1600})
+    page.on("pageerror", lambda e: errors.append(str(e)))
+    page.on("console", lambda m: errors.append(m.text) if m.type == "error" else None)
+    page.route("http://harness.local/**", lambda route: route.fulfill(
+        status=200, content_type="text/html", body="<body><div id='usage-bar'></div></body>"))
+    page.add_init_script(f"window.__ORCH_LANG__ = '{lang}';")
+    page.goto("http://harness.local/")
+    page.add_style_tag(path=str(STYLE_CSS))
+    for script in SCRIPTS:
+        page.add_script_tag(path=str(script))
+    page.evaluate(
+        """async raw => { api = async () => raw; QuotaPanel.init(); await QuotaPanel.fetch(); }""",
+        payload,
+    )
+    page.click("#quota-lines-toggle")
+    page.add_style_tag(content=f".ql-body {{ max-height: none !important; overflow: visible !important; }}"
+                               f" .ql-chart {{ width: {width}px !important; max-height: none !important; }}")
+    return page, errors
+
+
+def _polyline(page, bucket: str) -> list[tuple[float, float]]:
+    raw = page.locator(f"[data-ql-timeline-history='{bucket}']").get_attribute("points")
+    return [tuple(map(float, pair.split(","))) for pair in raw.split()]
+
+
+def _samples(payload: dict, name: str) -> list[dict]:
+    now = _now_ms(payload)
+    return [s for s in _bucket(payload, name)["timeline"]["points"]
+            if now - HALF_MS <= s["ts"] * 1000 <= now]
+
+
+@pytest.mark.parametrize("name", ["anthropic", "codex"])
+def test_fact_line_is_drawn_from_every_live_sample(browser, name):
+    payload = _live()
+    now = _now_ms(payload)
+    page, errors = _open(browser, payload)
+    assert page.locator(f"[data-ql-timeline-history='{name}']").count() == 1
+    points = _polyline(page, name)
+    samples = _samples(payload, name)
+    assert len(samples) >= 160 and len(points) >= len(samples)
+
+    drawn = iter(points)
+    for sample in samples:
+        want = (_x(sample["ts"] * 1000, now), _y(sample["utilization"]))
+        assert any(abs(p[0] - want[0]) < 1e-6 and abs(p[1] - want[1]) < 1e-6 for p in drawn), \
+            f"sample {sample} is not on the drawn line (or out of order)"
+
+    current = _bucket(payload, name)["window"]["utilization"]
+    assert points[-1] == pytest.approx((_x(now, now), _y(current)))
+    assert points[0][0] == pytest.approx(_x(samples[0]["ts"] * 1000, now))
+    assert points[-1][0] - points[0][0] > 0.6 * PLOT_W / 2, "line must span most of the past half"
+
+    style = page.evaluate("""name => {
+        const el = document.querySelector(`[data-ql-timeline-history='${name}']`);
+        const cs = getComputedStyle(el);
+        const ctm = el.ownerSVGElement.getScreenCTM();
+        const pts = el.points, mid = pts[Math.floor(pts.length / 2)];
+        const hit = document.elementFromPoint(ctm.a * mid.x + ctm.e, ctm.d * mid.y + ctm.f);
+        return {stroke: cs.stroke, width: parseFloat(cs.strokeWidth), opacity: parseFloat(cs.opacity),
+                display: cs.display, visibility: cs.visibility, hit: hit === el};
+    }""", name)
+    assert style["stroke"] not in ("none", "") and style["width"] >= 2 and style["opacity"] == 1
+    assert style["display"] != "none" and style["visibility"] == "visible"
+    assert style["hit"], "something is painted over the fact line"
+    assert errors == [], errors
+    page.close()
+
+
+def test_codex_window_reset_is_a_vertical_drop_at_the_old_window_end(browser):
+    payload = _live()
+    now = _now_ms(payload)
+    samples = _samples(payload, "codex")
+    drop = next(i for i in range(1, len(samples)) if samples[i]["utilization"] < samples[i - 1]["utilization"] - 50)
+    reset_ms = samples[drop - 1]["resets_at"] * 1000
+    assert samples[drop - 1]["ts"] * 1000 < reset_ms < samples[drop]["ts"] * 1000
+    page, _ = _open(browser, payload)
+    points = _polyline(page, "codex")
+    step = [(a, b) for a, b in zip(points, points[1:]) if a[0] == pytest.approx(b[0]) and b[1] - a[1] > 300]
+    assert len(step) == 1, step
+    assert step[0][0][0] == pytest.approx(_x(reset_ms, now))
+    assert step[0][0][1] == pytest.approx(_y(samples[drop - 1]["utilization"]))
+    assert step[0][1][1] == pytest.approx(_y(samples[drop]["utilization"]))
+    page.close()
+
+
+def test_every_lane_has_its_own_visible_current_point_on_the_center_line(browser):
+    payload = _live()
+    now = _now_ms(payload)
+    page, _ = _open(browser, payload)
+    expected = {"luna": _bucket(payload, "codex")["window"]["utilization"],
+                "sol": _bucket(payload, "codex")["window"]["utilization"],
+                "claude": _bucket(payload, "anthropic")["window"]["utilization"]}
+    circles = page.locator("[data-ql-timeline-point]")
+    assert circles.count() == 3, "spark has no data: no point, and no invented zero"
+    now_x = float(page.locator("[data-ql-timeline] .ql-now").get_attribute("x1"))
+    assert now_x == pytest.approx(_x(now, now))
+    radii = {}
+    for lane, util in expected.items():
+        circle = page.locator(f"[data-ql-timeline-point='{lane}']")
+        assert float(circle.get_attribute("cx")) == pytest.approx(now_x)
+        assert float(circle.get_attribute("cy")) == pytest.approx(_y(util))
+        radii[lane] = float(circle.get_attribute("r"))
+        assert page.locator(f"[data-ql-timeline-label='{lane}']").count() == 1
+    assert radii["luna"] != radii["sol"], "lanes sharing a pool must be nested, not stacked"
+
+    def topmost(lane: str, radius: float) -> str:
+        return page.evaluate("""([lane, radius]) => {
+            const el = document.querySelector(`[data-ql-timeline-point='${lane}']`);
+            const ctm = el.ownerSVGElement.getScreenCTM();
+            const cx = +el.getAttribute('cx') + radius, cy = +el.getAttribute('cy');
+            return document.elementFromPoint(ctm.a * cx + ctm.e, ctm.d * cy + ctm.f)
+                ?.getAttribute('data-ql-timeline-point') ?? null;
+        }""", [lane, radius])
+
+    for lane in ("luna", "sol", "claude"):
+        assert topmost(lane, radii[lane]) == lane, f"the {lane} ring is hidden by another element"
+    labels = {lane: page.locator(f"[data-ql-timeline-label='{lane}']").text_content() for lane in expected}
+    assert labels["claude"].endswith("90%") and labels["sol"].endswith("33%") and labels["luna"].endswith("33%")
+    page.close()
