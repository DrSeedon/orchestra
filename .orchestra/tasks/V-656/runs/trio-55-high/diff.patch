+def bg_cron_set_timeout_notified(job_id: str, notified: bool) -> bool:
+    """Атомарно выставить флаг «о таймауте цель уже уведомлена». True — флаг изменился."""
+    with _conn() as c:
+        c.execute("BEGIN IMMEDIATE")
+        row = c.execute("SELECT config, status FROM bg_jobs WHERE id=?", (job_id,)).fetchone()
+        if not row or row["status"] != "active":
+            c.execute("ROLLBACK")
+            return False
+        try:
+            cfg = json.loads(row["config"])
+        except (json.JSONDecodeError, TypeError):
+            cfg = {}
+        if bool(cfg.get("timeout_notified")) == notified:
+            c.execute("ROLLBACK")
+            return False
+        if notified:
+            cfg["timeout_notified"] = True
+        else:
+            cfg.pop("timeout_notified", None)
+        c.execute("UPDATE bg_jobs SET config=? WHERE id=?", (json.dumps(cfg), job_id))
+        c.execute("COMMIT")
+        return True
+
