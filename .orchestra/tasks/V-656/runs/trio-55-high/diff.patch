+def test_startup_creates_attention_events_on_a_v3_database_without_it(attention_app):
+    db, owner, _app = attention_app
+    with sqlite3.connect(db.DB_PATH) as connection:
+        connection.execute("DROP TABLE attention_events")
+    assert db.SCHEMA_VERSION == 3
+
+    db.ensure_attention_events_schema()
+
+    assert _attention_table(db.DB_PATH) == []
+    with sqlite3.connect(db.DB_PATH) as connection:
+        connection.execute("PRAGMA foreign_keys=ON")
+        connection.execute(
+            "INSERT INTO attention_events VALUES('e1','incident','r',?, 'now')", (owner,)
+        )
+
+
+def test_attention_events_ensure_is_idempotent_and_keeps_hand_made_rows(attention_app):
+    db, owner, _app = attention_app
+    with sqlite3.connect(db.DB_PATH) as connection:
+        connection.execute(
+            "INSERT INTO attention_events VALUES('manual','waiting','kept',?, 'now')", (owner,)
+        )
+
+    db.ensure_attention_events_schema()
+    db.ensure_attention_events_schema()
+
+    assert _attention_table(db.DB_PATH) == [("manual", "waiting", "kept")]
+
+
