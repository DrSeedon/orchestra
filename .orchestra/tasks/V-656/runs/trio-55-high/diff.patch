+    db.init_db()
+    with sqlite3.connect(database) as connection:
+        connection.execute("DROP TABLE attention_events")
+    monkeypatch.setattr(db, "init_db", lambda *a, **k: None)
+
+    with TestClient(main.app):
+        pass
+
+    assert _attention_table(database) == []
