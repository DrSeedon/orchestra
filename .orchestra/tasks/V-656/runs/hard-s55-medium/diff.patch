@@ -0,0 +1,99 @@
+"""V-620: an idle, clean worker releases its stale task binding on switch_worker_branch."""
+
+import pytest
+
+from tests.task_seeds import create_task as seed_task
+from tests.test_task_binding_417 import _init_db, _save_worker, _seed_project
+
+CLEAN = {"uncommitted": [], "unmerged_commits": []}
+
+
+def _setup(monkeypatch, wip):
+    import app.routes.sessions as sessions_route
+    from app import tm
+    from app.manager import SessionManager
+
+    _init_db()
+    _seed_project()
+    with tm._conn() as connection:
+        old = seed_task(connection, "project", "Old", par_number=41, status="in_progress")
+        new = seed_task(connection, "project", "New", par_number=42)
+    _save_worker(session_id="w620", task_id="41", branch="task-41/w620")
+    with tm._conn() as connection:
+        connection.execute("UPDATE tm_tasks SET worker_session_id='w620' WHERE id=?", (old["id"],))
+        tm._open_task_run_for_task(connection, tm.get_task_by_id(connection, old["id"]), "w620")
+    local_manager = SessionManager()
+    monkeypatch.setattr(sessions_route, "manager", local_manager)
+    monkeypatch.setattr(sessions_route, "_session_base_branch", lambda *_a: "main")
+    monkeypatch.setattr(
+        sessions_route, "_existing_branch_verdict",
+        lambda *_a, **_k: {"recreate_from_base": False, "discard_current": False},
+    )
+    monkeypatch.setattr(
+        "app.workspace.switch_worktree_branch",
+        lambda _p, branch, **_k: {"ok": True, "branch": branch},
+    )
+    monkeypatch.setattr("app.workspace.branch_wip_status", lambda *_a, **_k: dict(wip))
+    return sessions_route, tm, old, new
+
+
+def _state(tm, task_id):
+    with tm._conn() as connection:
+        task = tm.get_task_by_id(connection, task_id)
+        runs = connection.execute(
+            "SELECT task_id,status,failure_code FROM review_receipts "
+            "WHERE subject_kind='task_run' AND session_id='w620' ORDER BY requested_at",
+        ).fetchall()
+    return task, [dict(r) for r in runs]
+
+
+@pytest.mark.asyncio
+async def test_clean_idle_switch_releases_previous_task(monkeypatch):
+    route, tm, old, new = _setup(monkeypatch, CLEAN)
+    result = await route.switch_branch("w620", {"scope": "/scope", "task_id": "42"})
+    assert result["ok"] is True, result
+    prev, runs = _state(tm, old["id"])
+    assert (prev["status"], prev["worker_session_id"]) == ("new", None)
+    assert [(r["task_id"], r["status"]) for r in runs] == [("41", "interrupted"), ("42", "requested")]
+    cur, _ = _state(tm, new["id"])
+    assert (cur["status"], cur["worker_session_id"]) == ("in_progress", "w620")
+
+
+@pytest.mark.asyncio
+async def test_previous_task_done_closes_with_reason(monkeypatch):
+    route, tm, old, new = _setup(monkeypatch, CLEAN)
+    result = await route.switch_branch(
+        "w620", {"scope": "/scope", "task_id": "42", "previous_task_done": "смержено в main"},
+    )
+    assert result["ok"] is True, result
+    assert result["task_status"]["previous_task"]["outcome"] == "done"
+    prev, runs = _state(tm, old["id"])
+    assert (prev["status"], prev["worker_session_id"]) == ("done", None)
+    assert runs[0]["status"] == "completed"
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("wip", [
+    {"uncommitted": ["a.py"], "unmerged_commits": []},
+    {"uncommitted": [], "unmerged_commits": ["work"]},
+    {"error": "git broke"},
+])
+async def test_dirty_or_unmerged_keeps_binding(monkeypatch, wip):
+    route, tm, old, _new = _setup(monkeypatch, wip)
+    result = await route.switch_branch("w620", {"scope": "/scope", "task_id": "42"})
+    assert result["ok"] is False
+    assert "conflicts with current assignment provenance" in result["error"]
+    prev, runs = _state(tm, old["id"])
+    assert (prev["status"], prev["worker_session_id"]) == ("in_progress", "w620")
+    assert [r["status"] for r in runs] == ["requested"]
+
+
+@pytest.mark.asyncio
+async def test_previous_task_done_refused_on_dirty_tree(monkeypatch):
+    route, tm, old, _new = _setup(monkeypatch, {"uncommitted": ["a.py"], "unmerged_commits": []})
+    result = await route.switch_branch(
+        "w620", {"scope": "/scope", "task_id": "42", "previous_task_done": "готово"},
+    )
+    assert result.status_code == 409
+    prev, _ = _state(tm, old["id"])
+    assert prev["status"] == "in_progress"
