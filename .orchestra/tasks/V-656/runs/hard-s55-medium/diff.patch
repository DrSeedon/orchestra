+def _release_previous_binding(
+    conn: sqlite3.Connection,
+    session_id: str,
+    scope: str,
+    project_id: str,
+    previous_ref: str,
+    *,
+    done_reason: str,
+) -> dict:
+    """Close the session's open binding to an idle worker's previous task (V-620).
+
+    Default frees the worker: the run is interrupted and the task returns to the queue.
+    A non-empty `done_reason` closes the task as done instead. The caller has already
+    proved the worker idle with a clean tree; this runs inside its transaction, so a
+    failed assignment leaves the old binding untouched.
+    """
+    previous = resolve_task_ref(conn, previous_ref, project_id)
+    if previous and str(previous.get("worker_session_id") or "") == session_id:
+        if done_reason:
+            others = _live_bindings(conn, scope, public_task_ref(previous), session_id)
+            if others:
+                raise ValueError(
+                    f"task #{previous['par_number']} still has live workers "
+                    f"({', '.join(sorted(others))}) — closing it as done is refused"
+                )
+            update_task(conn, previous["id"], status="done")
+            _finish_task_run_for_task(
+                conn, previous, session_id, status="completed",
+            )
+            conn.execute(
+                "UPDATE tm_tasks SET worker_session_id=NULL, "
+                "sync_revision=sync_revision+1, updated_at=? WHERE id=?",
+                (_now(), previous["id"]),
+            )
+            active_runtime().publish(conn, previous["id"])
+            return {"task": public_task_ref(previous), "outcome": "done", "reason": done_reason}
+        release_session_task_binding(conn, session_id)
+    elif done_reason:
+        raise ValueError(
+            f"previous task {previous_ref} is not bound to session '{session_id}' — "
+            "nothing to close as done"
+        )
+    # A run left open without a task binding would still block the next assignment.
+    if previous:
+        _finish_task_run_for_task(
+            conn, previous, session_id, status="interrupted", failure_code="binding_released",
+        )
+    return {"task": previous_ref, "outcome": "released", "reason": ""}
+
