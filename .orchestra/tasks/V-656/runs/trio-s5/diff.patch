+def test_missing_attention_events_table_is_created_on_an_already_migrated_database(
+    tmp_path, monkeypatch, _isolate_project_catalog,
+):
+    """#V-653: V-576 never added attention_events to the v2→v3 migration, only
+    to schema.sql for fresh installs — a database that reached schema_version 3
+    some other way (already migrated, or hand-patched before this fix) could
+    still lack the table, and notify_user died with 'no such table'."""
+    _isolate_project_catalog.write_text(_CATALOG, encoding="utf-8")
+    project_catalog.reset_cache()
+
+    database = tmp_path / "orchestra.db"
+    monkeypatch.setattr(db, "DB_PATH", database)
+    db.init_db()
+    with sqlite3.connect(database) as connection:
+        connection.execute("DROP TABLE attention_events")
+        connection.execute("PRAGMA user_version=3")
+
+    root = tmp_path / "tasks"
+    root.mkdir()
+
+    result = migrate_v576(database, root)
+
+    assert result == {"state": "already"}
+    with sqlite3.connect(database) as connection:
+        tables = {
+            r[0] for r in connection.execute(
+                "SELECT name FROM sqlite_master WHERE type='table'"
+            )
+        }
+    assert "attention_events" in tables
+
+    # Idempotent: a second start (table now present, same as if an operator
+    # had created it by hand) must not error or drop it.
+    second = migrate_v576(database, root)
+    assert second == {"state": "already"}
+    with sqlite3.connect(database) as connection:
+        tables = {
+            r[0] for r in connection.execute(
+                "SELECT name FROM sqlite_master WHERE type='table'"
+            )
+        }
+    assert "attention_events" in tables
+
