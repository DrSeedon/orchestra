@@ -62,6 +62,37 @@ def _database_needs_migration(connection: sqlite3.Connection) -> bool:
     return "tags" not in columns
 
 
+_ATTENTION_EVENTS_DDL = """CREATE TABLE IF NOT EXISTS attention_events (
+                id TEXT PRIMARY KEY,
+                kind TEXT NOT NULL
+                    CHECK(kind IN ('legacy','incident','reversal','plan_change','waiting')),
+                reason TEXT NOT NULL,
+                source_session_id TEXT NOT NULL REFERENCES sessions(id),
+                created_at TEXT NOT NULL
+            )"""
+
+
+def _ensure_attention_events_table(database: Path) -> bool:
+    """V-576 добавила ``attention_events`` только в ``schema.sql`` для новых баз,
+    а сюда, в миграцию v2→v3, — нет: базы, доехавшие до version=3 старым путём,
+    оставались без таблицы, и ``notify_user`` падал ``no such table:
+    attention_events`` (#V-653, 28.09.2026 — VPS и ноутбук чинили руками той же
+    DDL). ``IF NOT EXISTS`` делает это безопасным и там, где её уже создали вручную.
+    """
+    connection = sqlite3.connect(str(database))
+    try:
+        before = connection.execute(
+            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='attention_events'"
+        ).fetchone()
+        if before:
+            return False
+        connection.execute(_ATTENTION_EVENTS_DDL)
+        connection.commit()
+        return True
+    finally:
+        connection.close()
+
+
 def _backup(database: Path) -> Path:
     stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
