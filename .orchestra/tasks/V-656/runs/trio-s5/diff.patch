+    # Не привязано к schema_version tm_tasks: базы с версией 3 без ALTER'а (уже
+    # мигрированные, или свежие до появления таблицы в schema.sql) всё равно
+    # нуждаются в этом — проверяется и чинится на каждом старте, а не только
+    # когда что-то из основной миграции ещё pending.
+    if _ensure_attention_events_table(database):
+        logger.warning("V-576 migration: created missing attention_events table")
     with sqlite3.connect(str(database)) as probe:
         pending_database = _database_needs_migration(probe)
     marker = task_repository / "task-store.json"
