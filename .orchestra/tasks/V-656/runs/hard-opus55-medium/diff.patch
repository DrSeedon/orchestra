+"""#V-620: after merge_worker(continue) a clean idle worker must not stay bound forever.
+
+switch_worker_branch releases the previous task (default) or closes it as done with an
+explicit reason; dirty trees and unmerged commits keep the binding.
+"""
+
+from tests.task_seeds import create_task as seed_task
+
+import subprocess
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+from fastapi.responses import JSONResponse
+
+from tests.test_task_tracker_integration import (
+    _commit_file,
+    _init_db,
+    _make_git_scope,
+    _save_worker,
+)
+
+
+def _clinch(monkeypatch, tmp_path: Path, name: str):
+    """The 23.09 state: task in_progress with an open run, worker branch == main."""
+    import app.routes.sessions as sessions_route
+    import app.workspace as workspace
+    from app import tm
+    from app.manager import SessionManager
+
+    _init_db()
+    repo = _make_git_scope(monkeypatch, tmp_path)
+    scope = str(repo)
+    with tm._conn() as connection:
+        tm.ensure_project(connection, "project", scope=scope)
+        previous = seed_task(
+            connection, "project", "Research phase", par_number=42, status="in_progress",
+        )
+        target = seed_task(connection, "project", "Next task", par_number=43)
+    worktree = workspace.create_worktree(scope, name)
+    branch = f"task-42/{name}"
+    subprocess.run(
+        ["git", "checkout", "-B", branch, "main"],
+        cwd=worktree.path, check=True, capture_output=True,
+    )
+    _save_worker(
+        session_id=name, task_id="42", scope=scope,
+        worktree_path=worktree.path, branch=branch,
+    )
+    with tm._conn() as connection:
+        connection.execute(
+            "UPDATE tm_tasks SET worker_session_id=? WHERE id=?", (name, previous["id"]),
+        )
+        tm._open_task_run_for_task(
+            connection, tm.get_task_by_id(connection, previous["id"]), name,
+        )
+        connection.commit()
+    local_manager = SessionManager()
+    monkeypatch.setattr(sessions_route, "manager", local_manager)
+    found = local_manager.get_by_name(name, scope)
+    return scope, worktree, found, previous, target
+
+
+def _runs(session_id: str) -> dict[str, dict]:
+    from app import tm
+
+    with tm._conn() as connection:
+        rows = connection.execute(
+            "SELECT task_id, status, failure_code FROM review_receipts "
+            "WHERE subject_kind='task_run' AND session_id=?",
+            (session_id,),
+        ).fetchall()
+    return {row["task_id"]: dict(row) for row in rows}
+
+
+def _task(task_id: int) -> dict:
+    from app import tm
+
+    with tm._conn() as connection:
+        return tm.get_task_by_id(connection, task_id)
+
+
+def _branch(worktree_path: str) -> str:
+    return subprocess.run(
+        ["git", "branch", "--show-current"], cwd=worktree_path,
+        check=True, capture_output=True, text=True,
+    ).stdout.strip()
+
+
+def _system_logs(session_id: str) -> list[str]:
+    from app import tm
+
+    with tm._conn() as connection:
+        rows = connection.execute(
+            "SELECT content FROM logs WHERE session_id=? AND type='system'", (session_id,),
+        ).fetchall()
+    return [row["content"] for row in rows]
+
+
+def _assert_still_bound(name: str, worktree, previous: dict, target: dict) -> None:
+    from app.db import get_session
+
+    assert _branch(worktree.path) == f"task-42/{name}"
+    assert get_session(name)["task_id"] == "42"
+    kept = _task(previous["id"])
+    assert (kept["status"], kept["worker_session_id"]) == ("in_progress", name)
+    assert _runs(name)["42"]["status"] == "requested"
+    untouched = _task(target["id"])
+    assert (untouched["status"], untouched["worker_session_id"]) == ("new", None)
+
+
+@pytest.mark.asyncio
+async def test_v620_clean_switch_releases_previous_task_back_to_queue(monkeypatch, tmp_path):
+    """Reproduces the clinch: before the fix this failed with an assignment-provenance conflict."""
+    import app.routes.sessions as sessions_route
+    from app.db import get_session
+
+    scope, worktree, found, previous, target = _clinch(monkeypatch, tmp_path, "clinch")
+
+    result = await sessions_route.switch_branch("clinch", {"scope": scope, "task_id": "43"})
+
+    assert not isinstance(result, JSONResponse), result.body
+    assert result["ok"] is True, result
+    assert result["previous_task"]["outcome"] == "released"
+    assert _branch(worktree.path) == "task-43/clinch"
+    assert get_session(found.id)["task_id"] == "43"
+    released = _task(previous["id"])
+    assert (released["status"], released["worker_session_id"]) == ("new", None)
+    assert released["completed_at"] is None
+    assigned = _task(target["id"])
+    assert (assigned["status"], assigned["worker_session_id"]) == ("in_progress", "clinch")
+    runs = _runs("clinch")
+    assert (runs["42"]["status"], runs["42"]["failure_code"]) == (
+        "interrupted", "binding_released",
+    )
+    assert runs["43"]["status"] == "requested"
+    assert any("42" in line and "освобождена" in line for line in _system_logs("clinch"))
+
