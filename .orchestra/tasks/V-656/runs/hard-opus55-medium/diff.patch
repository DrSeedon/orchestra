+def open_switch_release_binding(scope: str, session_id: str, task_ref: str) -> dict | None:
+    """The open binding a branch switch may release, or None when there is none (#V-620).
+
+    Only a task that is still in_progress, owned by this session and has an open task
+    run counts: that is exactly the state `merge_worker(continue)` leaves behind, and
+    the one the next assignment would otherwise collide with forever.
+    """
+    if not str(task_ref or ""):
+        return None
+    with active_runtime().operation(), _conn() as conn:
+        project = get_project_by_scope(conn, scope.rstrip("/"))
+        task = resolve_task_ref(conn, task_ref, project["id"]) if project else None
+        if (
+            not task
+            or task["status"] != "in_progress"
+            or str(task.get("worker_session_id") or "") != session_id
+        ):
+            return None
+        run = conn.execute(
+            "SELECT receipt_id FROM review_receipts WHERE subject_kind='task_run' "
+            "AND session_id=? AND task_id=? AND status='requested'",
+            (session_id, public_task_ref(task)),
+        ).fetchone()
+        if run is None:
+            return None
+        return {"task_ref": public_task_ref(task), "task_id": task["id"]}
+
+
+def _release_switched_task(conn: sqlite3.Connection, release: dict) -> dict:
+    """Close the previous binding inside the caller's assignment transaction.
+
+    Default is release: the run ends interrupted and the task goes back to the queue.
+    `done` is the orchestrator's explicit word that the previous task is finished.
+    """
+    session_id = str(release["session_id"])
+    done = bool(release.get("done"))
+    if done and not str(release.get("reason") or "").strip():
+        raise ValueError("closing the previous task as done requires a reason")
+    project = get_project_by_scope(conn, str(release["scope"]).rstrip("/"))
+    task = resolve_task_ref(conn, str(release["task_ref"]), project["id"]) if project else None
+    if (
+        not task
+        or task["status"] != "in_progress"
+        or str(task.get("worker_session_id") or "") != session_id
+    ):
+        raise ValueError(
+            f"previous task '{release['task_ref']}' binding changed before switch"
+        )
+    run = _finish_task_run_for_task(
+        conn,
+        task,
+        session_id,
+        status="completed" if done else "interrupted",
+        failure_code="" if done else "binding_released",
+    )
+    if run is None:
+        raise ValueError(
+            f"previous task '{release['task_ref']}' has no open task run to close"
+        )
+    new_status = "done" if done else "new"
+    update_task(conn, task["id"], status=new_status)
+    conn.execute(
+        "UPDATE tm_tasks SET worker_session_id=NULL, sync_revision=sync_revision+1, "
+        "updated_at=? WHERE id=?",
+        (_now(), task["id"]),
+    )
+    active_runtime().publish(conn, task["id"])
+    return {
+        "par": public_task_ref(task),
+        "outcome": "done" if done else "released",
+        "new_status": new_status,
+        "task_run": run["status"],
+    }
