+@pytest.mark.asyncio
+async def test_v620_new_assignment_failure_keeps_previous_binding(monkeypatch, tmp_path):
+    """Release and new assignment are one transaction: a failed claim rolls both back."""
+    import app.routes.sessions as sessions_route
+    from app import tm
+
+    scope, worktree, _found, previous, target = _clinch(monkeypatch, tmp_path, "atomic")
+    real_update = tm.update_task
+
+    def fail_new_claim(connection, task_id, **kwargs):
+        if task_id == target["id"]:
+            raise RuntimeError("injected claim failure")
+        return real_update(connection, task_id, **kwargs)
+
+    monkeypatch.setattr(tm, "update_task", fail_new_claim)
+
+    result = await sessions_route.switch_branch("atomic", {"scope": scope, "task_id": "43"})
+
+    assert result["ok"] is False
+    assert result["state"] == "task_assignment_failed"
+    _assert_still_bound("atomic", worktree, previous, target)
+
