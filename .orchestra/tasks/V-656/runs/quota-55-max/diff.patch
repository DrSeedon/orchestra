+    claude = _points(page.locator("[data-ql-timeline-history='anthropic']"))
+    assert all(b[1] <= a[1] + 0.01 for a, b in zip(claude, claude[1:])), "у Claude нет сброса, линия не должна падать"
+    page.close()
