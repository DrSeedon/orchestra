@@ -14,6 +14,16 @@ const _QL_REFRESH_MS = 120000;
 const _QL_LABEL_STEP = 12;
 const _QL_LABEL_TOP_PAD = 8;
 
+// Ось времени шкалы: три строки подписей под графиком (часы, граница ночи, день недели),
+// поэтому высота шкалы больше, чем у старого графика (`_QL_H`), а поле графика то же.
+const _QL_TH = 486;
+const _QL_ZONE_MS = 7 * 3600000;
+const _QL_HOUR_MS = 3600000;
+const _QL_TICK_HOURS = 2;
+const _QL_TEXT_EVERY_HOURS = 4;
+const _QL_NIGHT_START_HOUR = 0, _QL_NIGHT_END_HOUR = 8;
+const _QL_POOL_COLORS = {codex: '#f472b6', codex_spark: '#c084fc', anthropic: '#fb923c'};
+
 const _QL_PANELS = [
     {key: 'all', title: T('Pool quotas'), sub: T('single scale: window progress share, 0–100%'),
      buckets: ['codex', 'codex_spark', 'anthropic']},
@@ -232,6 +242,63 @@ function _qlLanes(panel) {
     return lanes;
 }
 
+// Ось времени Красноярска: засечка каждые 2 часа, текст на каждой второй (кратной 4 ч) —
+// подпись «ЧЧ» шириной ~13 ед. не помещается в шаг 10,5 ед. (2 ч при 168 ч на 886 ед.).
+// Границы ночи 00:00 и 08:00 подписаны ВСЕГДА и на своих строках (время, день недели),
+// поэтому с обычными подписями не сталкиваются, а между собой разнесены на 42 ед.
+function _qlTimeAxis(x, from, to) {
+    const bottom = _QL_MT + _QL_PH;
+    const locale = typeof orchLang === 'function' && orchLang() === 'ru' ? 'ru-RU' : 'en-US';
+    const weekdayFormat = new Intl.DateTimeFormat(locale, {timeZone: 'UTC', weekday: 'short'});
+    const step = _QL_TICK_HOURS * _QL_HOUR_MS;
+    const out = [];
+    for (let tick = Math.ceil((from + _QL_ZONE_MS) / step) * step - _QL_ZONE_MS; tick <= to; tick += step) {
+        const local = tick + _QL_ZONE_MS;
+        const hour = Math.floor(local / _QL_HOUR_MS) % 24;
+        const hh = String(hour).padStart(2, '0');
+        const tx = x(tick);
+        const meta = `data-ql-tick="${hh}" data-ql-tick-ts="${tick}"`;
+        const edge = hour === _QL_NIGHT_START_HOUR ? 'start' : hour === _QL_NIGHT_END_HOUR ? 'end' : '';
+        if (edge) {
+            out.push(`<line class="ql-night-edge" data-ql-night-edge="${edge}" ${meta} x1="${tx}" y1="${_QL_MT}" x2="${tx}" y2="${bottom + 21}"/>`);
+            out.push(`<text class="ql-axis ql-axis-border" data-ql-night-label="${edge}" data-ql-tick-ts="${tick}" x="${tx}" y="${bottom + 36}" text-anchor="middle">${hh}:00</text>`);
+            out.push(`<text class="ql-axis ql-axis-weekday" data-ql-night-weekday="${edge}" data-ql-tick-ts="${tick}" x="${tx}" y="${bottom + 50}" text-anchor="middle">${_escHtml(weekdayFormat.format(new Date(local)))}</text>`);
+            continue;
+        }
+        const labeled = hour % _QL_TEXT_EVERY_HOURS === 0;
+        if (labeled) out.push(`<line class="ql-grid" x1="${tx}" y1="${_QL_MT}" x2="${tx}" y2="${bottom}"/>`);
+        out.push(`<line class="ql-tick" ${meta} x1="${tx}" y1="${bottom}" x2="${tx}" y2="${bottom + (labeled ? 7 : 4)}"/>`);
+        if (labeled) out.push(`<text class="ql-axis ql-axis-hour" data-ql-hour-label="${hh}" data-ql-tick-ts="${tick}" x="${tx}" y="${bottom + 20}" text-anchor="middle">${hh}</text>`);
+    }
+    return out;
