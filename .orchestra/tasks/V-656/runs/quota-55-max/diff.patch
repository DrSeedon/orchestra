+def test_window_reset_inside_the_range_is_a_vertical_drop(browser):
+    payload = _live()
+    now_ms = _now_ms(payload)
+    codex = _bucket(payload, "codex")["timeline"]["points"]
+    reset_ms = max(p["resets_at"] for p in codex if p["resets_at"] * 1000 < now_ms) * 1000
+    before = [p for p in codex if p["ts"] * 1000 < reset_ms][-1]["utilization"]
