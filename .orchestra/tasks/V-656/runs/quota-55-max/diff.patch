+    timeline = page.locator("[data-ql-timeline='all']")
+    for name in ("codex", "anthropic"):
+        line = timeline.locator(f"[data-ql-timeline-history='{name}']")
+        assert line.count() == 1, f"{name}: нет фактической линии"
+        points = _points(line)
+        history = len(_bucket(payload, name)["timeline"]["points"])
+        # Линия несёт ВСЕ снимки за 3,5 суток (а не пару точек), поэтому обрезка истории краснит тест.
+        assert len(points) >= history, (name, len(points), history)
+        xs = [px for px, _ in points]
+        assert xs == sorted(xs), f"{name}: время идёт назад"
+        assert xs[0] < PLOT_LEFT + 5, f"{name}: линия начинается не у левого края шкалы"
+        current = _bucket(payload, name)["window"]["utilization"]
+        assert points[-1] == pytest.approx((_x(now_ms, now_ms), _y(current)), abs=0.01), f"{name}: конец линии не в текущей точке"
+    assert timeline.locator("[data-ql-timeline-history]").count() == 2
+    assert errors == [], errors
