+def test_axis_labels_do_not_overlap_at_any_chart_width(browser, lang, viewport):
+    payload = _live()
+    now_ms = _now_ms(payload)
+    # Часовые подписи (кратные 4 ч, без границ ночи) + время и день недели у каждой границы.
+    expected_labels = (len(_instants(now_ms, 4, lambda m: m.hour not in (0, 8)))
+                       + 2 * len(_instants(now_ms, 8, lambda m: m.hour in (0, 8))))
+    page, _ = _render(browser, payload, lang=lang, width=viewport)
+    boxes = page.evaluate(
+        """() => {
+            const svg = document.querySelector('[data-ql-timeline]');
+            const svgBox = svg.getBoundingClientRect();
+            const nodes = [...svg.querySelectorAll('[data-ql-hour-label], [data-ql-night-label], [data-ql-night-weekday]')];
+            return {
+                width: svgBox.width,
+                left: svgBox.left, right: svgBox.right, top: svgBox.top, bottom: svgBox.bottom,
+                boxes: nodes.map(n => {
+                    const r = n.getBoundingClientRect();
+                    return {text: n.textContent, left: r.left, right: r.right, top: r.top, bottom: r.bottom};
+                }),
+            };
+        }"""
+    )
+    if viewport == VIEWPORT_FOR_900:
+        assert boxes["width"] == pytest.approx(900, abs=2), boxes["width"]
+    assert len(boxes["boxes"]) == expected_labels == 56, "часть подписей не нарисована — проверять на налезание нечего"
+    for box in boxes["boxes"]:
+        assert boxes["left"] <= box["left"] and box["right"] <= boxes["right"], f"подпись выходит за график: {box}"
+        assert boxes["top"] <= box["top"] and box["bottom"] <= boxes["bottom"], f"подпись выходит за график: {box}"
+    clashes = []
+    ordered = boxes["boxes"]
+    for i, a in enumerate(ordered):
+        for b in ordered[i + 1:]:
+            apart_x = a["right"] <= b["left"] + 0.01 or b["right"] <= a["left"] + 0.01
+            apart_y = a["bottom"] <= b["top"] + 0.01 or b["bottom"] <= a["top"] + 0.01
+            if not (apart_x or apart_y):
+                clashes.append((a["text"], b["text"]))
+    assert clashes == [], f"подписи налезают друг на друга: {clashes[:5]}"
+    page.close()
