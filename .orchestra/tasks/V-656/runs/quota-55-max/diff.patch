+@pytest.mark.parametrize("lang", ["ru", "en"])
+def test_axis_has_a_tick_every_two_hours_text_every_other_and_labeled_night_borders(browser, lang):
+    payload = _live()
+    now_ms = _now_ms(payload)
+    page, errors = _render(browser, payload, lang=lang)
+    timeline = page.locator("[data-ql-timeline='all']")
+
+    every_two_hours = _instants(now_ms, 2, lambda m: True)
+    ticks = timeline.locator("[data-ql-tick]")
+    assert ticks.count() == len(every_two_hours) == 84
+    tick_ts = [int(ticks.nth(i).get_attribute("data-ql-tick-ts")) for i in range(ticks.count())]
+    assert tick_ts == [int(m.timestamp() * 1000) for m in every_two_hours]
+    assert all(int(ticks.nth(i).get_attribute("data-ql-tick")) % 2 == 0 for i in range(ticks.count()))
+    xs = [float(ticks.nth(i).get_attribute("x1")) for i in range(ticks.count())]
+    assert xs == pytest.approx([_x(ts, now_ms) for ts in tick_ts], abs=0.01)
+
+    # Текст на каждой второй засечке (кратной 4 ч); 00:00 и 08:00 — отдельные подписи границ.
+    plain = [m for m in _instants(now_ms, 4, lambda m: m.hour not in (0, 8))]
+    labels = timeline.locator("[data-ql-hour-label]")
+    assert [labels.nth(i).text_content() for i in range(labels.count())] == [f"{m.hour:02d}" for m in plain]
+    label_x = [float(labels.nth(i).get_attribute("x")) for i in range(labels.count())]
+    assert label_x == pytest.approx([_x(m.timestamp() * 1000, now_ms) for m in plain], abs=0.01)
+
+    for edge, hour in (("start", 0), ("end", 8)):
+        expected = _instants(now_ms, 8, lambda m, h=hour: m.hour == h)
+        times = timeline.locator(f"[data-ql-night-label='{edge}']")
+        days = timeline.locator(f"[data-ql-night-weekday='{edge}']")
+        assert times.count() == days.count() == len(expected) >= 7, (edge, times.count(), len(expected))
+        for i, moment in enumerate(expected):
+            assert times.nth(i).text_content() == f"{hour:02d}:00"
+            assert days.nth(i).text_content().lower() == WEEKDAYS[lang][moment.weekday()].lower(), (lang, edge, moment)
+            assert float(times.nth(i).get_attribute("x")) == pytest.approx(_x(moment.timestamp() * 1000, now_ms), abs=0.01)
+
+    # Подпись границы и подсветка ночи стоят на одной вертикали: ось и заливка не разъехались.
+    nights = timeline.locator(".ql-night")
+    start_x = sorted(float(timeline.locator("[data-ql-night-edge='start']").nth(i).get_attribute("x1"))
+                     for i in range(timeline.locator("[data-ql-night-edge='start']").count()))
+    end_x = sorted(float(timeline.locator("[data-ql-night-edge='end']").nth(i).get_attribute("x1"))
+                   for i in range(timeline.locator("[data-ql-night-edge='end']").count()))
+    band_left = [float(nights.nth(i).get_attribute("x")) for i in range(nights.count())]
+    band_right = [float(nights.nth(i).get_attribute("x")) + float(nights.nth(i).get_attribute("width"))
+                  for i in range(nights.count())]
+    assert all(any(abs(left - x) < 0.01 for x in start_x) for left in band_left[1:])
+    assert all(any(abs(right - x) < 0.01 for x in end_x) for right in band_right[:-1] if right < PLOT_LEFT + PLOT_WIDTH - 0.01)
+    assert errors == [], errors
+    page.close()
+
