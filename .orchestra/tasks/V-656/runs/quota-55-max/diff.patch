+def _instants(now_ms: int, hour_step: int, predicate):
+    """Независимый от JS перебор: локальное время Красноярска через datetime, а не арифметику мс."""
+    result = []
+    moment = datetime.fromtimestamp((now_ms - HALF_MS) / 1000, ZONE).replace(minute=0, second=0, microsecond=0)
+    end = datetime.fromtimestamp((now_ms + HALF_MS) / 1000, ZONE)
+    start = datetime.fromtimestamp((now_ms - HALF_MS) / 1000, ZONE)
+    while moment <= end:
+        if moment >= start and moment.hour % hour_step == 0 and predicate(moment):
+            result.append(moment)
+        moment += timedelta(hours=1)
+    return result
+
