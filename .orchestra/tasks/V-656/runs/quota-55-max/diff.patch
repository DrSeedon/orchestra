@@ -0,0 +1,404 @@
+"""Шкала «Квоты пула» по времени (V-654): фактические линии расхода и ось времени.
+
+Владелец 28.09: «нет линий пройденого результата» и «по x нормальные лейблы, везде
+каждые 2 часа метка». Стенд гонит через настоящий `quota-lines.js` в Chromium ЖИВОЙ ответ
+`/api/usage/quota-map` (фикстура `tests/fixtures/quota_map_live_v654.json` — тот же JSON,
+что сохранён с дашборда: формой не тронут, `generated_at` зафиксирован, поэтому шкала
+не зависит от даты прогона).
+
+Линия «есть в DOM» ничего не доказывает: её перекрывал бы порог того же цвета или скрыл бы
+CSS. Поэтому проверки идут через `elementFromPoint` — что на самом деле лежит сверху в
+точках линии, — и через геометрию подписей оси в пикселях.
+
+Скриншот-доказательство пишется в каталог из переменной V654_SCREENSHOT_DIR (по умолчанию
+временный): тест не должен пачкать дерево репозитория при каждом прогоне.
+    V654_SCREENSHOT_DIR=.orchestra/tasks/V-654 python -m pytest tests/test_v654_quota_timeline_browser.py
+"""
+import json
+import os
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+import pytest
+from playwright.sync_api import Browser, sync_playwright
+
+ROOT = Path(__file__).parent.parent
+FIXTURE = ROOT / "tests/fixtures/quota_map_live_v654.json"
+STYLE_CSS = ROOT / "app/static/css/style.css"
+JS_DIR = ROOT / "app/static/js"
+VENDOR_JS = [ROOT / "app/static/css/vendor" / name for name in (
+    "marked.min.js", "purify.min.js", "diff_match_patch.js", "highlight.min.js")]
+SCRIPTS = [JS_DIR / "i18n.js", JS_DIR / "utils.js", JS_DIR / "quota-lines.js",
+           JS_DIR / "connection.js", JS_DIR / "app.js"]
+
+# Геометрия шкалы в единицах viewBox — те же числа, что в quota-lines.js (`_QL_*`).
+PLOT_LEFT, PLOT_WIDTH, PLOT_TOP, PLOT_HEIGHT = 54.0, 886.0, 18.0, 408.0
+HALF_MS = 84 * 3600 * 1000
+ZONE = timezone(timedelta(hours=7))
+# Ширина графика на экране ~900 px: viewport минус поля body (16) и .ql-body (24).
+VIEWPORT_FOR_900 = 940 - 16
+
+WEEKDAYS = {
+    "ru": ["пн", "вт", "ср", "чт", "пт", "сб", "вс"],
+    "en": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
+}
+
+
+@pytest.fixture(scope="module")
+def browser():
+    with sync_playwright() as playwright:
+        instance = playwright.chromium.launch(headless=True)
+        yield instance
+        instance.close()
+
+
+def _live() -> dict:
+    return json.loads(FIXTURE.read_text(encoding="utf-8"))
+
+
+def _render(browser: Browser, payload: dict, lang: str = "ru", width: int = VIEWPORT_FOR_900):
+    """Страница как на дашборде: те же скрипты и стили, панель раскрыта, высота не режется."""
+    errors: list = []
+    page = browser.new_page(viewport={"width": width, "height": 1800})
+    page.on("pageerror", lambda e: errors.append(str(e)))
+    page.on("console", lambda m: errors.append(m.text) if m.type == "error" else None)
+    page.route("http://harness.local/**", lambda route: route.fulfill(
+        status=200, content_type="text/html", body="<body><div id='usage-bar'></div></body>"))
+    page.add_init_script(f"window.__ORCH_LANG__ = '{lang}';")
+    page.goto("http://harness.local/")
+    page.add_style_tag(path=str(STYLE_CSS))
+    for script in [*VENDOR_JS, *SCRIPTS]:
+        page.add_script_tag(path=str(script))
+    assert page.evaluate("typeof QuotaPanel?.init") == "function"
+    page.evaluate(
+        """async raw => {
+            api = async () => raw;
+            QuotaPanel.init();
+            await QuotaPanel.fetch();
+        }""",
+        payload,
+    )
+    page.click("#quota-lines-toggle")
+    # Скролл внутри .ql-body прячет верх графика — так и потерялась точка Claude 90% на
+    # скриншоте владельца; стенд показывает график целиком.
+    page.add_style_tag(content=".ql-body { max-height: none !important; overflow: visible !important; }")
+    return page, errors
+
+
+def _now_ms(payload: dict) -> int:
+    return int(datetime.fromisoformat(payload["generated_at"]).timestamp() * 1000)
+
+
+def _x(ts_ms: float, now_ms: int) -> float:
+    from_ms = now_ms - HALF_MS
+    return PLOT_LEFT + (ts_ms - from_ms) / (2 * HALF_MS) * PLOT_WIDTH
+
+
+def _y(pct: float) -> float:
+    return PLOT_TOP + (1 - pct / 100) * PLOT_HEIGHT
+
+
+def _points(polyline) -> list:
+    raw = polyline.get_attribute("points").split()
+    return [tuple(float(v) for v in pair.split(",")) for pair in raw]
+
+
+def _bucket(payload: dict, name: str) -> dict:
+    return next(b for b in payload["buckets"] if b["bucket"] == name)
+
+
+def _screenshot_dir(tmp_path: Path) -> Path:
+    target = os.environ.get("V654_SCREENSHOT_DIR")
+    directory = ROOT / target if target else tmp_path
+    directory.mkdir(parents=True, exist_ok=True)
+    return directory
+
