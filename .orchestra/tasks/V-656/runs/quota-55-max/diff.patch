+def test_actual_lines_are_the_topmost_thing_at_their_own_points(browser):
+    """Линия обязана быть ВИДНА: сверху над ней нет порога, сетки или подписи.
+
+    Ловит и «линию скрыл CSS» (display/opacity/stroke), и «линию нарисовали под порогом
+    того же цвета» — по DOM оба дефекта не отличить от исправной.
+    """
+    payload = _live()
+    page, _ = _render(browser, payload)
+    for name in ("codex", "anthropic"):
+        hits = page.evaluate(
+            """name => {
+                const svg = document.querySelector('[data-ql-timeline]');
+                const line = svg.querySelector(`[data-ql-timeline-history="${name}"]`);
+                const style = getComputedStyle(line);
+                const pts = line.getAttribute('points').trim().split(/\\s+/).map(p => p.split(',').map(Number));
+                const ctm = svg.getScreenCTM();
+                let own = 0, checked = 0;
+                for (let i = 3; i < pts.length - 3; i += 4) {
+                    const [ux, uy] = pts[i];
+                    const sx = ctm.a * ux + ctm.e, sy = ctm.d * uy + ctm.f;
+                    const top = document.elementFromPoint(sx, sy);
+                    checked += 1;
+                    if (top === line) own += 1;
+                }
+                return {own, checked, width: parseFloat(style.strokeWidth), opacity: parseFloat(style.opacity),
+                        stroke: style.stroke, display: style.display, visibility: style.visibility};
+            }""",
+            name,
+        )
+        assert hits["display"] != "none" and hits["visibility"] == "visible", hits
+        assert hits["width"] >= 3 and hits["opacity"] >= 0.9, hits
+        assert hits["checked"] >= 40, hits
+        assert hits["own"] / hits["checked"] >= 0.85, f"{name}: линию перекрывает другой слой: {hits}"
+    page.close()
+
