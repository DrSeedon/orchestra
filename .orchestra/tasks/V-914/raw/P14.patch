+class RestartStatusHeaderMiddleware:
+    """Expose the current mutating-admission state on every HTTP response."""
+
+    def __init__(self, app):
+        self.app = app
+
+    async def __call__(self, scope, receive, send):
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        async def send_with_restart_status(message):
+            if message["type"] == "http.response.start":
+                headers = list(message.get("headers") or [])
+                headers = [(name, value) for name, value in headers
+                           if name.lower() != b"x-orchestra-restarting"]
+                value = b"0" if _mutating_admission_open else b"1"
+                headers.append((b"x-orchestra-restarting", value))
+                message = {**message, "headers": headers}
+            await send(message)
+
+        await self.app(scope, receive, send_with_restart_status)
+
+
