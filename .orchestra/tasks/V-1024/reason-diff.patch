+@pytest.mark.asyncio
+@pytest.mark.parametrize('model,reason', [('hubsonnet', REASON), ('hubsol', ''), ('sonnet', '')])
+async def test_spawn_reason_survives_database_reload_and_both_dashboard_lists(
+    manager, tmp_path, model, reason,
+):
