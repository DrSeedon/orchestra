+        child_pid = int((await asyncio.wait_for(proc.stdout.readline(), 2)).decode())
+        unrelated = await asyncio.create_subprocess_exec(
+            "/bin/sleep", "30", start_new_session=True,
+        )
+        try:
+            await _kill_proc(proc)
