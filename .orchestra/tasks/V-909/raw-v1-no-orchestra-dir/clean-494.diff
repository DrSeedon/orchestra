+        dirs[:] = [
+            name for name in dirs
+            if name not in _WORKSPACE_PRIVATE_TOPLEVEL
+        ]
+        for name in names:
+            relative = relative_root / name
+            if any(part in _WORKSPACE_PRIVATE_TOPLEVEL for part in relative.parts):
+                continue
