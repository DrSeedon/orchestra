+def _parse_lane_hard_stops(raw: object) -> dict[str, float]:
+    name = "QUOTA_LANE_HARD_STOP_PCT"
+    if not isinstance(raw, str):
+        raise ValueError(f"{name}: value must be a comma-separated list of lane=percent")
+    if raw == "":
+        return {}
+    result = {}
+    for item in raw.split(","):
+        lane, separator, percent = item.partition("=")
+        lane = lane.strip().lower()
+        if not separator or not lane:
+            raise ValueError(f"{name}: expected lane=percent, got {item!r}")
+        result[lane] = _parse_float(percent, name, 1.0, 100.0)
+    return result
+
