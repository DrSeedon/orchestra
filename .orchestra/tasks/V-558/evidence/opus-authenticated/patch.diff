+def _parse_lane_hard_stops(raw: object, name: str) -> dict[str, float]:
+    """Разобрать ``sol=95,luna=90`` в потолки полос.
+
+    Пустая строка — «специальных потолков нет». Любой кривой элемент (без ``=``,
+    с пустым именем полосы, с нечисловым или выходящим за 1..100 процентом,
+    пустой из-за лишней запятой) — ValueError с именем переменной: молча
+    проглоченный потолок означал бы неожиданно работающий гейт.
+    """
+    if raw is None:
+        raise ValueError(f"{name}: value must be a comma-separated list of lane=percent pairs")
+    raw = str(raw).strip()
+    if raw == "":
+        return {}
+    result: dict[str, float] = {}
+    for part in raw.split(","):
+        item = part.strip()
+        if item == "":
+            raise ValueError(f"{name}: empty lane=percent item in {raw!r}")
+        if "=" not in item:
+            raise ValueError(
+                f"{name}: item must be 'lane=percent', got {item!r}"
+            )
+        lane_raw, _, value_raw = item.partition("=")
+        lane = lane_raw.strip().lower()
+        if lane == "":
+            raise ValueError(f"{name}: empty lane name in {item!r}")
+        if "=" in value_raw:
+            raise ValueError(f"{name}: item must be 'lane=percent', got {item!r}")
+        percent = _parse_float(value_raw, f"{name} [{lane}]", 1.0, 100.0)
+        if lane in result:
+            raise ValueError(f"{name}: duplicate lane {lane!r} in {raw!r}")
+        result[lane] = percent
+    return result
+
+
+def _env_lane_hard_stops(name: str, default: Mapping[str, float]) -> dict[str, float]:
+    if name not in os.environ:
+        return {lane: float(value) for lane, value in default.items()}
+    return _parse_lane_hard_stops(os.environ[name], name)
+
+
