+def _parse_lane_hard_stops(raw: object, name: str) -> Mapping[str, float]:
+    """``sol=95,luna=90`` → {"sol": 95.0, "luna": 90.0}.
+
+    Набор ЗАМЕНЯЕТ предыдущий, а не дополняет его: полоса, которой в строке нет,
+    возвращается к общему потолку. Пустая строка — специальных потолков нет.
+    Любой кривой элемент (``sol``, ``sol=abc``, ``sol=101``, ``=95``, хвостовая запятая)
+    — ошибка конфигурации с именем переменной, а не тихий пропуск.
+    """
+    if raw is None:
+        raise ValueError(f"{name}: value must be a comma-separated list of lane=percent items")
+    raw = str(raw)
+    if raw.strip() == "":
+        return MappingProxyType({})
+    result: dict[str, float] = {}
+    for part in raw.split(","):
+        item = part.strip()
+        if item == "":
+            raise ValueError(f"{name}: empty item in {raw!r}")
+        lane, separator, value = item.partition("=")
+        lane = lane.strip().lower()
+        if not separator:
+            raise ValueError(f"{name}: item {item!r} must look like lane=percent")
+        if lane == "":
+            raise ValueError(f"{name}: empty lane name in item {item!r}")
+        if lane in result:
+            raise ValueError(f"{name}: lane {lane!r} is listed more than once in {raw!r}")
+        result[lane] = _parse_float(value, f"{name}[{lane}]", _LANE_HARD_STOP_MIN, _LANE_HARD_STOP_MAX)
+    return MappingProxyType(result)
+
+
+def _normalize_lane_hard_stops(value: object, name: str = "lane_hard_stop_pct") -> Mapping[str, float]:
+    """Привести mapping, переданный в `QuotaPolicy`, к неизменяемому виду."""
+    if value is None:
+        return MappingProxyType({})
+    if isinstance(value, str):
+        return _parse_lane_hard_stops(value, name)
+    if not isinstance(value, Mapping):
+        raise ValueError(f"{name}: value must be a mapping of lane -> percent")
+    result: dict[str, float] = {}
+    for lane, pct in value.items():
+        if not isinstance(lane, str) or lane.strip() == "":
+            raise ValueError(f"{name}: lane names must be non-empty strings, got {lane!r}")
+        key = lane.strip().lower()
+        if key in result:
+            raise ValueError(f"{name}: lane {key!r} is listed more than once")
+        if isinstance(pct, bool) or not isinstance(pct, (int, float, str)):
+            raise ValueError(f"{name}[{key}]: value must be a finite number, got {pct!r}")
+        result[key] = _parse_float(pct, f"{name}[{key}]", _LANE_HARD_STOP_MIN, _LANE_HARD_STOP_MAX)
+    return MappingProxyType(result)
+
