+
+def _parse_lane_hard_stops(raw: object, name: str) -> dict[str, float]:
+    """Parse a complete ``lane=percent`` override set.
+
+    An explicitly empty value is meaningful: it removes every lane-specific stop.
+    Every non-empty comma-separated item must be complete so a typo cannot silently
+    leave a lane protected by a different limit than the operator intended.
+    """
+    if raw is None:
+        raise ValueError(f"{name}: value must be a comma-separated lane=percent mapping")
+    raw = str(raw)
+    if raw == "":
+        return {}
+
+    result: dict[str, float] = {}
+    for item in raw.split(","):
+        item = item.strip()
+        if not item or "=" not in item:
+            raise ValueError(f"{name}: invalid lane hard stop item {item!r}")
+        lane, percentage = item.split("=", 1)
+        lane = lane.strip().lower()
+        if not lane:
+            raise ValueError(f"{name}: lane name must not be empty")
+        result[lane] = _parse_float(percentage, name, 1.0, 100.0)
+    return result
+
