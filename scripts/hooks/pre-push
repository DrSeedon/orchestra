#!/bin/sh
# orchestra-secret-gate (#453) — последний рубеж перед ПУБЛИКАЦИЕЙ: ловит то, что попало
# в историю мимо pre-commit (`--no-verify`, `git am`, старая ветка воркера, чужой чекаут).
set -e
root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
py="$root/.venv/bin/python"
[ -x "$py" ] || py=python3
scan="$root/scripts/secret_scan.py"
if [ ! -f "$scan" ]; then
  echo "secret-gate: нет $scan (главный чекаут на ветке без гейта)." >&2
  echo "secret-gate: верни файл либо сними хук: rm $(git rev-parse --git-common-dir)/hooks/pre-push" >&2
  exit 1
fi
exec "$py" "$scan" --pre-push
