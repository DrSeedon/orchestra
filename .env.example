# Proxy (optional — needed in Russia, not needed in EU/US)
# HTTPS_PROXY=http://127.0.0.1:12334
# HTTP_PROXY=http://127.0.0.1:12334
# NO_PROXY=localhost,127.0.0.1

# Currency symbol displayed in dashboard (default: ₽)
# CURRENCY_SYMBOL=₽

# Dashboard Auth (REQUIRED for public deployment)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-use-openssl-rand

# Internal token for MCP callback auth (REQUIRED for public deployment)
INTERNAL_TOKEN=change-me-use-openssl-rand-hex-32

# RAG semantic memory (optional). Off by default. To enable:
#   1) uv sync --extra rag     2) pre-cache model into data/models/ (HF blocked on some proxies)
#   3) set RAG_ENABLED=true
# RAG_ENABLED=false
# RAG_DB_PATH=data/vec.db
# ORCHESTRA_DB_PATH=data/orchestra.db
# CPU throttle for background reindex (default: gentle — won't freeze the UI):
# RAG_ONNX_THREADS=2   # ONNX intra-op threads (0 = all cores = ~490% CPU on 12-core). 2 = quiet
# RAG_NICE=10          # os.nice() for the backfill thread (0 = don't renice)
# RAG_EMBED_BATCH=16   # embed batch size (16 = ~1.6GB peak; 64 = faster but ~2.4GB peak)

# Cookie secure flag (set to 1 behind HTTPS)
# COOKIE_SECURE=1

# SQLite DB path override (optional — relative to project root or absolute).
# Useful so different worktrees/branches use separate DB files and don't
# block each other via SQLite locks when run in parallel.
# Default: data/orchestra.db
# ORCHESTRA_DB_PATH=data/orchestra.db

# Claude CLI path override (optional)
# CLAUDE_CLI_PATH=/usr/local/bin/claude

# TG Bridge (optional)
# TG_BRIDGE_TOKEN=your-bot-token
# TG_BRIDGE_GROUP=-100xxxxxxxxxx
# Give each worker its own TG topic (default: workers are silent in TG;
# their reports to orchestrator are visible in the orchestrator's topic as 📨 [from:worker])
# TG_WORKER_TOPICS=1
# Tag this username in agent's messages to you (agent "speech" → 💬), so you get
# notifications for messages addressed to you (not for agent-to-agent traffic 📨).
# TG_USER_MENTION=@your_username

# Kesha inbox (optional)
# KESHA_INBOX_URL=http://127.0.0.1:18081

# Deepgram voice transcription (optional)
# DEEPGRAM_API_KEY=your-api-key

# Local Telegram Bot API (optional — enables files up to 2GB)
# TG_LOCAL_API_URL=http://localhost:8081

# GitHub webhook (optional)
# GITHUB_WEBHOOK_SECRET=your-webhook-secret
# GITHUB_TOKEN=your-github-token
# GITHUB_REPO_SCOPE_MAP=owner/repo1=/path/to/project,owner/repo2=/path/to/project

# Codex CLI path override (optional)
# CODEX_BIN=/usr/local/bin/codex

# SSH tunnel to VPS (optional — auto-reconnect, replaces standalone systemd tunnel)
# SSH_TUNNEL_HOST=194.87.250.243
# SSH_TUNNEL_KEY=/path/to/key.pem
# SSH_TUNNEL_LOCAL_PORT=12338
# SSH_TUNNEL_REMOTE_PORT=18080

# Open folder in file manager (disabled by default, local dev only)
# ALLOW_OPEN_FOLDER=1

# Allowed project root paths for worktree creation (colon-separated, optional)
# ALLOWED_ROOTS=/home/user/projects:/opt/projects

# Telegram diff images for Edit/Write (set to 0 to disable code diff screenshots in TG)
# TG_DIFF_IMAGES=true

# Telegram result images for Read/Grep/Bash (opt-in, off by default — they spam flood control)
# TG_RESULT_IMAGES=false

# Max upload size for TG file transfers in MB (default: 1024)
# UPLOADS_MAX_MB=1024

# Proxy list for rotation (format: name|url,name|url — optional)
# PROXY_LIST=hiddify|http://127.0.0.1:12334,vpn2|http://127.0.0.1:12335

# YouGile task sync (optional)
# YOUGILE_SEEDON_TOKEN=your-yougile-api-token
