[Unit]
Description=Refresh Orchestra OAuth Kill-Switch DNS VIPs (bounded deadline)
Requires=orchestra-oauth-killswitch.service
After=orchestra-oauth-killswitch.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=20s
ExecStart=/usr/local/sbin/orchestra-refresh-oauth-killswitch --refresh-dns

[Install]
WantedBy=multi-user.target
